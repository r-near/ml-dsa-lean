--- /dev/null
+++ b/core/crypto/tests/ab_bench.rs
@@ -0,0 +1,184 @@
+//! A/B timing of the two ML-DSA-65 backends inside one process, on one core, alternating calls.
+//! Needed because the build box is shared and a pair of separate processes sees different load.
+//! Not part of the adoption patch. Run:
+//!   cargo test --release -p near-crypto --features ml-dsa-lean --test ab_bench -- --ignored --nocapture
+#![cfg(feature = "ml-dsa-lean")]
+
+use aws_lc_rs::encoding::{AsRawBytes, PqdsaPrivateKeyRaw};
+use aws_lc_rs::signature::{
+    KeyPair, ML_DSA_65, ML_DSA_65_SIGNING, PqdsaKeyPair, UnparsedPublicKey,
+};
+use ml_dsa_lean::api::{keygen_65, sign_65, verify_65};
+use std::hint::black_box;
+use std::time::Instant;
+
+const PK: usize = 1952;
+const SK: usize = 4032;
+const SIG: usize = 3309;
+const KEYS: usize = 64;
+const PAIRS: usize = 30_000;
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);
+        z ^ (z >> 31)
+    }
+}
+
+fn pct(v: &mut Vec<u64>, p: f64) -> u64 {
+    v.sort_unstable();
+    v[((v.len() - 1) as f64 * p) as usize]
+}
+
+fn report(name: &str, aws: &mut Vec<u64>, lean: &mut Vec<u64>, ratios: &mut Vec<f64>) {
+    ratios.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let r = ratios[ratios.len() / 2];
+    let line = |label: &str, v: &mut Vec<u64>| {
+        let mean = v.iter().sum::<u64>() as f64 / v.len() as f64;
+        format!(
+            "    {label:5} min {:8.2} p10 {:8.2} p25 {:8.2} median {:8.2} mean {:8.2} p90 {:8.2} us",
+            pct(v, 0.0) as f64 / 1e3,
+            pct(v, 0.10) as f64 / 1e3,
+            pct(v, 0.25) as f64 / 1e3,
+            pct(v, 0.50) as f64 / 1e3,
+            mean / 1e3,
+            pct(v, 0.90) as f64 / 1e3
+        )
+    };
+    println!("  {name}: median of per-pair lean/aws ratios = {r:.3}");
+    println!("{}", line("aws", aws));
+    println!("{}", line("lean", lean));
+    println!(
+        "    ratio lean/aws: min {:.3}  p10 {:.3}  p25 {:.3}  median {:.3}",
+        pct(lean, 0.0) as f64 / pct(aws, 0.0) as f64,
+        pct(lean, 0.10) as f64 / pct(aws, 0.10) as f64,
+        pct(lean, 0.25) as f64 / pct(aws, 0.25) as f64,
+        pct(lean, 0.5) as f64 / pct(aws, 0.5) as f64
+    );
+}
+
+#[test]
+#[ignore]
+fn ab_bench() {
+    let mut rng = Rng(42);
+    let msg = [0x5au8; 32];
+    let mut pks = Vec::new();
+    let mut sigs = Vec::new();
+    let mut sks = Vec::new();
+    for _ in 0..KEYS {
+        let mut seed = [0u8; 32];
+        for b in seed.iter_mut() {
+            *b = rng.next() as u8;
+        }
+        let (pk, sk) = keygen_65(&seed);
+        sigs.push(sign_65(&sk, &msg, &[], &[0; 32]).unwrap());
+        pks.push(pk);
+        sks.push(sk);
+    }
+    let mut garbage = vec![[0u8; SIG]; KEYS];
+    for g in garbage.iter_mut() {
+        for b in g.iter_mut() {
+            *b = rng.next() as u8;
+        }
+    }
+    let wrong_msg = [0xa5u8; 32];
+
+    let aws_v = |pk: &[u8; PK], m: &[u8], s: &[u8; SIG]| {
+        UnparsedPublicKey::new(&ML_DSA_65, &pk[..]).verify(m, &s[..]).is_ok()
+    };
+    let lean_v = |pk: &[u8; PK], m: &[u8], s: &[u8; SIG]| verify_65(pk, m, &[], s);
+
+    println!(
+        "AB BENCH: {PAIRS} alternating pairs per row over {KEYS} keys; one thread; times per call"
+    );
+    for (mode, mk) in [("valid", 0), ("wrong-message", 1), ("random-bytes signature", 2)] {
+        let (mut a, mut l, mut r) = (Vec::new(), Vec::new(), Vec::new());
+        for i in 0..PAIRS {
+            let k = i % KEYS;
+            let (m, s): (&[u8], &[u8; SIG]) = match mk {
+                0 => (&msg, &sigs[k]),
+                1 => (&wrong_msg, &sigs[k]),
+                _ => (&msg, &garbage[k]),
+            };
+            let (ta, tl);
+            if i % 2 == 0 {
+                let t = Instant::now();
+                let x = aws_v(black_box(&pks[k]), black_box(m), black_box(s));
+                ta = t.elapsed().as_nanos() as u64;
+                black_box(x);
+                let t = Instant::now();
+                let y = lean_v(black_box(&pks[k]), black_box(m), black_box(s));
+                tl = t.elapsed().as_nanos() as u64;
+                black_box(y);
+            } else {
+                let t = Instant::now();
+                let y = lean_v(black_box(&pks[k]), black_box(m), black_box(s));
+                tl = t.elapsed().as_nanos() as u64;
+                black_box(y);
+                let t = Instant::now();
+                let x = aws_v(black_box(&pks[k]), black_box(m), black_box(s));
+                ta = t.elapsed().as_nanos() as u64;
+                black_box(x);
+            }
+            a.push(ta);
+            l.push(tl);
+            r.push(tl as f64 / ta as f64);
+        }
+        report(&format!("verify, {mode}"), &mut a, &mut l, &mut r);
+    }
+
+    // sign (hedged both sides) and keygen
+    let (mut a, mut l, mut r) = (Vec::new(), Vec::new(), Vec::new());
+    let aws_kps: Vec<PqdsaKeyPair> = sks
+        .iter()
+        .map(|sk| PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..]).unwrap())
+        .collect();
+    for i in 0..4000 {
+        let k = i % KEYS;
+        let mut rnd = [0u8; 32];
+        for b in rnd.iter_mut() {
+            *b = rng.next() as u8;
+        }
+        let mut buf = [0u8; SIG];
+        let t = Instant::now();
+        let n = aws_kps[k].sign(black_box(&msg), &mut buf).unwrap();
+        let ta = t.elapsed().as_nanos() as u64;
+        black_box((n, buf[0]));
+        let t = Instant::now();
+        let s = sign_65(black_box(&sks[k]), black_box(&msg), &[], black_box(&rnd)).unwrap();
+        let tl = t.elapsed().as_nanos() as u64;
+        black_box(s[0]);
+        a.push(ta);
+        l.push(tl);
+        r.push(tl as f64 / ta as f64);
+    }
+    report("sign (hedged), valid key", &mut a, &mut l, &mut r);
+    let (mut a, mut l, mut r) = (Vec::new(), Vec::new(), Vec::new());
+    for _ in 0..4000 {
+        let mut seed = [0u8; 32];
+        for b in seed.iter_mut() {
+            *b = rng.next() as u8;
+        }
+        let t = Instant::now();
+        let kp = PqdsaKeyPair::from_seed(&ML_DSA_65_SIGNING, black_box(&seed[..])).unwrap();
+        let raw: PqdsaPrivateKeyRaw<'static> = kp.private_key().as_raw_bytes().unwrap();
+        let mut sk = [0u8; SK];
+        sk.copy_from_slice(raw.as_ref());
+        let mut pk = [0u8; PK];
+        pk.copy_from_slice(kp.public_key().as_ref());
+        let ta = t.elapsed().as_nanos() as u64;
+        black_box((sk[0], pk[0]));
+        let t = Instant::now();
+        let (pk2, sk2) = keygen_65(black_box(&seed));
+        let tl = t.elapsed().as_nanos() as u64;
+        black_box((pk2[0], sk2[0]));
+        a.push(ta);
+        l.push(tl);
+        r.push(tl as f64 / ta as f64);
+    }
+    report("keygen from seed (incl. raw export)", &mut a, &mut l, &mut r);
+}
