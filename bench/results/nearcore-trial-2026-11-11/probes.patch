--- /dev/null
+++ b/core/crypto/tests/stack_probe.rs
@@ -0,0 +1,88 @@
+//! Stack probe (NOT part of the adoption patch): native stack used below the caller by the
+//! ML-DSA-65 paths of near-crypto, measured by painting. Backend = whichever the build selects.
+//!   cargo test -p near-crypto [--features ml-dsa-lean] --release --test stack_probe -- --nocapture
+use near_crypto::{
+    KeyType, ML_DSA_65_BACKEND, PublicKey, SecretKey, Signature, ml_dsa_65_from_seed,
+};
+use std::hint::black_box;
+use std::ptr::{read_volatile, write_bytes};
+
+const STACK: usize = 8 << 20;
+const PAINT: usize = 2 << 20;
+const GAP: usize = 8192;
+
+/// Bytes of stack used below this function's frame by `f` (granularity 1 byte, blind to the top GAP).
+#[inline(never)]
+fn used_by<R>(f: impl FnOnce() -> R) -> (R, usize) {
+    let marker = 0u8;
+    let sp = black_box(&marker) as *const u8 as usize;
+    let lo = sp - PAINT;
+    unsafe { write_bytes(lo as *mut u8, 0xAA, PAINT - GAP) };
+    let r = f();
+    let mut p = lo;
+    while p < sp - GAP && unsafe { read_volatile(p as *const u8) } == 0xAA {
+        p += 1;
+    }
+    (r, sp - p)
+}
+
+fn on_big_stack<R: Send>(f: impl FnOnce() -> R + Send) -> R {
+    std::thread::scope(|s| {
+        std::thread::Builder::new().stack_size(STACK).spawn_scoped(s, f).unwrap().join().unwrap()
+    })
+}
+
+#[test]
+fn stack_probe() {
+    on_big_stack(|| {
+        let sk = SecretKey::from_random(KeyType::MLDSA65);
+        let pk = sk.public_key();
+        let msg = [7u8; 32];
+        let sig = sk.sign(&msg);
+        let bad_msg = [8u8; 32];
+        let SecretKey::MLDSA65(_) = &sk else { unreachable!() };
+        let sk_str = sk.to_string();
+        let mut results: Vec<(&str, usize)> = Vec::new();
+        let mut record = |name: &'static str, reps: usize, mut f: Box<dyn FnMut() + '_>| {
+            let mut worst = 0;
+            for _ in 0..reps {
+                let (_, used) = used_by(|| f());
+                worst = worst.max(used);
+            }
+            results.push((name, worst));
+        };
+        record(
+            "Signature::verify (valid)",
+            5,
+            Box::new(|| assert!(black_box(&sig).verify(&msg, &pk))),
+        );
+        record(
+            "Signature::verify (wrong msg)",
+            5,
+            Box::new(|| assert!(!black_box(&sig).verify(&bad_msg, &pk))),
+        );
+        let PublicKey::MLDSA65(_) = &pk else { unreachable!() };
+        record("SecretKey::sign", 5, Box::new(|| drop(black_box(sk.sign(&msg)))));
+        record("SecretKey::public_key", 5, Box::new(|| drop(black_box(sk.public_key()))));
+        record(
+            "ml_dsa_65_from_seed",
+            5,
+            Box::new(|| drop(black_box(ml_dsa_65_from_seed(&[3; 32]).unwrap()))),
+        );
+        record(
+            "SecretKey::from_str (validate)",
+            5,
+            Box::new(|| drop(black_box(sk_str.parse::<SecretKey>().unwrap()))),
+        );
+        record(
+            "SecretKey::from_random",
+            5,
+            Box::new(|| drop(black_box(SecretKey::from_random(KeyType::MLDSA65)))),
+        );
+        let _ = Signature::default();
+        println!("STACK PROBE backend={ML_DSA_65_BACKEND}");
+        for (n, b) in results {
+            println!("  {n:34} {b:8} bytes ({:.1} KiB)", b as f64 / 1024.0);
+        }
+    });
+}
