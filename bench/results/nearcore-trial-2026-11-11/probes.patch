+++ b/runtime/near-vm-runner/src/tests/ml_dsa_stack_probe.rs
@@ -0,0 +1,114 @@
+//! Stack probe (NOT part of the adoption patch): native stack used by a contract that recurses
+//! DEPTH wasm frames deep and then (optionally) calls `ml_dsa_verify` at the bottom. Painted stack,
+//! one fresh thread per measurement. Env: PROBE_DEPTHS="0,1000,..." PROBE_VERIFY=1|0.
+use crate::ContractCode;
+use crate::logic::Config;
+use crate::logic::mocks::mock_external::MockedExternal;
+use crate::runner::VMKindExt;
+use crate::tests::{create_context, test_vm_config, with_vm_variants};
+use near_parameters::RuntimeFeesConfig;
+use near_parameters::vm::VMKind;
+use std::hint::black_box;
+use std::ptr::{read_volatile, write_bytes};
+use std::sync::Arc;
+
+const PUBKEY_HEX: &str = include_str!("probe_pk.hex");
+const SIG_HEX: &str = include_str!("probe_sig.hex");
+
+fn wat(depth: u32, verify: bool) -> String {
+    let data = |hex: &str| hex.trim().as_bytes().chunks(2).map(|c| format!("\\{}", std::str::from_utf8(c).unwrap())).collect::<String>();
+    let sig = data(SIG_HEX);
+    let pk = data(PUBKEY_HEX);
+    let msg = "\\07".repeat(32);
+    let call = if verify {
+        "(i64.store (i32.const 12288) (call $v (i64.const 3309) (i64.const 0) (i64.const 32) (i64.const 4096) (i64.const 1952) (i64.const 8192)))"
+    } else {
+        "(i64.store (i32.const 12288) (i64.const 1))"
+    };
+    format!(
+        r#"(module
+  (import "env" "ml_dsa_verify" (func $v (param i64 i64 i64 i64 i64 i64) (result i64)))
+  (import "env" "value_return" (func $value_return (param i64 i64)))
+  (memory (export "memory") 1)
+  (data (i32.const 0) "{sig}")
+  (data (i32.const 4096) "{msg}")
+  (data (i32.const 8192) "{pk}")
+  (func $rec (param $n i32)
+    (if (i32.eqz (local.get $n))
+      (then {call})
+      (else (call $rec (i32.sub (local.get $n) (i32.const 1))))))
+  (func (export "main")
+    (call $rec (i32.const {depth}))
+    (call $value_return (i64.const 8) (i64.const 12288))))"#
+    )
+}
+
+const STACK: usize = 256 << 20;
+const PAINT: usize = 128 << 20;
+const GAP: usize = 8192;
+
+#[inline(never)]
+fn used_by<R>(f: impl FnOnce() -> R) -> (R, usize) {
+    let marker = 0u8;
+    let sp = black_box(&marker) as *const u8 as usize;
+    let lo = sp - PAINT;
+    unsafe { write_bytes(lo as *mut u8, 0xAA, PAINT - GAP) };
+    let r = f();
+    let mut p = lo;
+    while p < sp - GAP && unsafe { read_volatile(p as *const u8) } == 0xAA {
+        p += 1;
+    }
+    (r, sp - p)
+}
+
+/// Run the contract on the current thread. Returns a short description of the outcome.
+pub(crate) fn run_contract(wat_src: &str, vm_kind: VMKind) -> String {
+    let mut config = test_vm_config(Some(vm_kind));
+    config.ml_dsa_verify_host_fn = true;
+    let config = Arc::new(config);
+    let fees = Arc::new(RuntimeFeesConfig::test());
+    let wasm = wat::parse_str(wat_src).expect("wat");
+    let code = ContractCode::new(wasm, None);
+    let mut ext = MockedExternal::with_code(code);
+    let context = create_context(vec![]);
+    let gas_counter = context
+        .make_gas_counter(&config)
+        .prepare_for_contract(&config, "main", ext.code_len())
+        .expect("load charge");
+    let runtime = vm_kind.runtime(Arc::<Config>::clone(&config)).expect("runtime");
+    let outcome = runtime
+        .prepare(&ext, None, gas_counter, "main")
+        .run(&mut ext, &context, Arc::clone(&fees));
+    match outcome {
+        Ok(o) => match &o.aborted {
+            None => format!("ok return={:?}", o.return_data),
+            Some(e) => format!("aborted: {e:?}").chars().take(80).collect(),
+        },
+        Err(e) => format!("error: {e:?}").chars().take(80).collect(),
+    }
+}
+
+#[test]
+fn ml_dsa_stack_probe() {
+    let depths: Vec<u32> = std::env::var("PROBE_DEPTHS")
+        .unwrap_or_else(|_| "0,1000,1500,2000,2500,3000,3500,4000,4500,5000".into())
+        .split(',')
+        .map(|s| s.parse().unwrap())
+        .collect();
+    let verify = std::env::var("PROBE_VERIFY").map(|v| v != "0").unwrap_or(true);
+    with_vm_variants(|vm_kind| {
+        println!("PROBE vm={vm_kind:?} verify={verify} backend={} max_stack_height={}", near_crypto::ML_DSA_65_BACKEND, test_vm_config(Some(vm_kind)).limit_config.max_stack_height);
+        for &d in &depths {
+            let src = wat(d, verify);
+            let (outcome, used) = std::thread::scope(|s| {
+                std::thread::Builder::new()
+                    .stack_size(STACK)
+                    .spawn_scoped(s, || used_by(|| run_contract(&src, vm_kind)))
+                    .unwrap()
+                    .join()
+                    .unwrap()
+            });
+            println!("  depth={d:7} native_stack_used={used:10} B ({:8.1} KiB)  {outcome}", used as f64 / 1024.0);
+        }
+    });
+}
