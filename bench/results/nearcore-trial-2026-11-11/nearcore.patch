diff --git a/core/crypto/tests/ml_dsa_backend_diff.rs b/core/crypto/tests/ml_dsa_backend_diff.rs
new file mode 100644
index 000000000..df0e76b20
--- /dev/null
+++ b/core/crypto/tests/ml_dsa_backend_diff.rs
@@ -0,0 +1,366 @@
+//! Differential test of the two ML-DSA-65 backends (aws-lc-rs vs ml-dsa-lean), both linked into one
+//! test binary. Only built with the `ml-dsa-lean` feature. Run:
+//!   cargo test -p near-crypto --features ml-dsa-lean --release --test ml_dsa_backend_diff -- --nocapture
+#![cfg(feature = "ml-dsa-lean")]
+
+use aws_lc_rs::encoding::{AsDer, AsRawBytes, PqdsaPrivateKeyRaw};
+use aws_lc_rs::signature::{
+    KeyPair, ML_DSA_65, ML_DSA_65_SIGNING, PqdsaKeyPair, UnparsedPublicKey,
+};
+use ml_dsa_lean::api::{keygen_65, pk_from_sk_65, sign_65, sk_is_well_formed_65, verify_65};
+use near_crypto::{
+    KeyType, ML_DSA_65_BACKEND, MlDsa65PublicKey, MlDsa65Signature, PublicKey, SecretKey, Signature,
+};
+
+const PK: usize = 1952;
+const SK: usize = 4032;
+const SIG: usize = 3309;
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);
+        z ^ (z >> 31)
+    }
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n as u64) as usize
+    }
+    fn bytes<const N: usize>(&mut self) -> [u8; N] {
+        let mut out = [0u8; N];
+        for b in &mut out {
+            *b = self.next() as u8;
+        }
+        out
+    }
+}
+
+fn aws_keypair_from_seed(seed: &[u8; 32]) -> ([u8; PK], [u8; SK]) {
+    let kp = PqdsaKeyPair::from_seed(&ML_DSA_65_SIGNING, &seed[..]).unwrap();
+    let raw: PqdsaPrivateKeyRaw<'static> = kp.private_key().as_raw_bytes().unwrap();
+    let mut pk = [0u8; PK];
+    pk.copy_from_slice(kp.public_key().as_ref());
+    (pk, <[u8; SK]>::try_from(raw.as_ref()).unwrap())
+}
+
+fn aws_sign(sk: &[u8; SK], msg: &[u8]) -> [u8; SIG] {
+    let kp = PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..]).unwrap();
+    let mut sig = [0u8; SIG];
+    assert_eq!(kp.sign(msg, &mut sig).unwrap(), SIG);
+    sig
+}
+
+fn aws_verify(pk: &[u8; PK], msg: &[u8], sig: &[u8; SIG]) -> bool {
+    UnparsedPublicKey::new(&ML_DSA_65, &pk[..]).verify(msg, &sig[..]).is_ok()
+}
+
+fn lean_verify(pk: &[u8; PK], msg: &[u8], sig: &[u8; SIG]) -> bool {
+    verify_65(pk, msg, &[], sig)
+}
+
+/// Verdict of the backend selected at build time, through nearcore's own `Signature::verify`.
+fn nearcore_verify(pk: &[u8; PK], msg: &[u8], sig: &[u8; SIG]) -> bool {
+    let pk = PublicKey::MLDSA65(MlDsa65PublicKey(Box::new(*pk)));
+    let sig = Signature::MLDSA65(MlDsa65Signature(Box::new(*sig)));
+    sig.verify(msg, &pk)
+}
+
+#[test]
+fn backend_is_lean() {
+    assert_eq!(ML_DSA_65_BACKEND, "ml-dsa-lean");
+}
+
+#[test]
+fn keygen_matches_aws_from_seed() {
+    let mut rng = Rng(1);
+    for i in 0..300 {
+        let seed: [u8; 32] = if i == 0 {
+            [0; 32]
+        } else if i == 1 {
+            [0xff; 32]
+        } else {
+            rng.bytes()
+        };
+        let (pk_a, sk_a) = aws_keypair_from_seed(&seed);
+        let (pk_l, sk_l) = keygen_65(&seed);
+        assert_eq!(pk_a, pk_l, "pk differs for seed {i}");
+        assert_eq!(sk_a[..], sk_l[..], "sk differs for seed {i}");
+    }
+}
+
+#[test]
+fn cross_sign_verify() {
+    let mut rng = Rng(2);
+    let lens = [0usize, 1, 31, 32, 33, 64, 255, 256, 1000, 16 * 1024];
+    let mut n = 0;
+    for i in 0..40 {
+        let seed: [u8; 32] = rng.bytes();
+        let (pk, sk) = keygen_65(&seed);
+        for &len in &lens {
+            let mut msg = vec![0u8; len];
+            for b in &mut msg {
+                *b = rng.next() as u8;
+            }
+            let rnd_zero = [0u8; 32];
+            let rnd: [u8; 32] = rng.bytes();
+            let s_lean_det = sign_65(&sk, &msg, &[], &rnd_zero).unwrap();
+            let s_lean_hedged = sign_65(&sk, &msg, &[], &rnd).unwrap();
+            let s_aws = aws_sign(&sk, &msg);
+            for (name, s) in
+                [("lean-det", &s_lean_det), ("lean-hedged", &s_lean_hedged), ("aws", &s_aws)]
+            {
+                assert!(aws_verify(&pk, &msg, s), "aws rejects {name} sig (key {i}, len {len})");
+                assert!(lean_verify(&pk, &msg, s), "lean rejects {name} sig (key {i}, len {len})");
+                assert!(nearcore_verify(&pk, &msg, s), "nearcore rejects {name} sig");
+                n += 1;
+            }
+            // Determinism: same key, message, rnd = 0 gives the same bytes; hedged differs.
+            assert_eq!(s_lean_det, sign_65(&sk, &msg, &[], &rnd_zero).unwrap());
+            assert_ne!(s_lean_det, s_lean_hedged);
+            // A wrong message must fail on both.
+            let mut bad = msg.clone();
+            bad.push(0);
+            assert!(!aws_verify(&pk, &bad, &s_lean_det));
+            assert!(!lean_verify(&pk, &bad, &s_lean_det));
+        }
+    }
+    println!("cross_sign_verify: {n} valid signatures accepted by both backends");
+}
+
+/// Verdict differential on mutated inputs. Counts the verdicts so the output shows that both
+/// accepting and rejecting inputs were covered.
+#[test]
+fn slow_test_verify_verdicts_agree_on_mutations() {
+    let mut rng = Rng(3);
+    let (mut total, mut accepted, mut diffs) = (0u64, 0u64, 0u64);
+    let mut check = |pk: &[u8; PK], msg: &[u8], sig: &[u8; SIG], what: &str| {
+        let a = aws_verify(pk, msg, sig);
+        let l = lean_verify(pk, msg, sig);
+        total += 1;
+        accepted += a as u64;
+        if a != l {
+            diffs += 1;
+            eprintln!("VERDICT DIFFERENCE ({what}): aws={a} lean={l}");
+        }
+    };
+    for k in 0..12 {
+        let seed: [u8; 32] = rng.bytes();
+        let (pk, sk) = keygen_65(&seed);
+        let msg: Vec<u8> = (0..(k * 37 % 200)).map(|i| i as u8).collect();
+        let sig = sign_65(&sk, &msg, &[], &rng.bytes()).unwrap();
+        check(&pk, &msg, &sig, "valid");
+        // Every single-bit flip in c~ (first 48 bytes) and the hint section, sampled flips elsewhere.
+        for bit in 0..(48 * 8) {
+            let mut s = sig;
+            s[bit / 8] ^= 1 << (bit % 8);
+            check(&pk, &msg, &s, "flip c~");
+        }
+        for bit in (3248 * 8)..(SIG * 8) {
+            let mut s = sig;
+            s[bit / 8] ^= 1 << (bit % 8);
+            check(&pk, &msg, &s, "flip hint");
+        }
+        for _ in 0..3000 {
+            let mut s = sig;
+            let bit = rng.below(SIG * 8);
+            s[bit / 8] ^= 1 << (bit % 8);
+            check(&pk, &msg, &s, "flip sig");
+        }
+        for _ in 0..1500 {
+            let mut p = pk;
+            let bit = rng.below(PK * 8);
+            p[bit / 8] ^= 1 << (bit % 8);
+            check(&p, &msg, &sig, "flip pk");
+        }
+        // Multi-byte and fill mutations of z.
+        for _ in 0..500 {
+            let mut s = sig;
+            let at = 48 + rng.below(3200);
+            let n = 1 + rng.below(64);
+            for j in at..(at + n).min(3248) {
+                s[j] = rng.next() as u8;
+            }
+            check(&pk, &msg, &s, "randomize z span");
+        }
+        for fill in [0x00u8, 0xff, 0x80, 0x7f] {
+            let mut s = sig;
+            for b in &mut s[48..3248] {
+                *b = fill;
+            }
+            check(&pk, &msg, &s, "fill z");
+        }
+        // Hint-encoding malformations: counts non-monotone, count > omega, nonzero padding, unsorted indices.
+        for _ in 0..800 {
+            let mut s = sig;
+            match rng.below(5) {
+                0 => s[3303 + rng.below(6)] = rng.next() as u8,
+                1 => s[3248 + rng.below(55)] = rng.next() as u8,
+                2 => {
+                    let w = s[3308] as usize;
+                    if w < 55 {
+                        s[3248 + w + rng.below(55 - w)] = 1 + (rng.next() % 255) as u8;
+                    }
+                }
+                3 => {
+                    let a = 3248 + rng.below(55);
+                    let b = 3248 + rng.below(55);
+                    s.swap(a, b);
+                }
+                _ => {
+                    s[3303 + rng.below(6)] = 56 + (rng.next() % 200) as u8;
+                }
+            }
+            check(&pk, &msg, &s, "hint malform");
+        }
+        // Random whole-signature and zero-signature, and random pk.
+        let s_rand: [u8; SIG] = rng.bytes();
+        check(&pk, &msg, &s_rand, "random sig");
+        check(&pk, &msg, &[0u8; SIG], "zero sig");
+        let p_rand: [u8; PK] = rng.bytes();
+        check(&p_rand, &msg, &sig, "random pk");
+        check(&[0u8; PK], &msg, &sig, "zero pk");
+        check(&[0xffu8; PK], &msg, &sig, "ff pk");
+        // Message changes.
+        let mut m2 = msg.clone();
+        m2.push(1);
+        check(&pk, &m2, &sig, "longer msg");
+        if !msg.is_empty() {
+            check(&pk, &msg[1..], &sig, "shorter msg");
+        }
+        // Cross-key: signature from key A, public key B.
+        let (pk_b, _) = keygen_65(&rng.bytes());
+        check(&pk_b, &msg, &sig, "wrong key");
+    }
+    println!(
+        "verify_verdicts_agree_on_mutations: {total} comparisons, {accepted} accepted by aws-lc, {diffs} differences"
+    );
+    assert_eq!(diffs, 0);
+}
