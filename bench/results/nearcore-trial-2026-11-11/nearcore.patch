+//! ML-DSA-65 backend: the only place that names the signature library.
+//!
+//! Default: `aws-lc-rs`. With the `ml-dsa-lean` Cargo feature: the `ml-dsa-lean` crate (pure Rust).
+//! Both take and return the raw FIPS 204 encodings (pk 1952, expanded sk 4032, signature 3309) and
+//! use the empty context string.
+
+use crate::signature::{
+    ML_DSA_65_PUBLIC_KEY_LENGTH as PK_LEN, ML_DSA_65_SECRET_KEY_LENGTH as SK_LEN,
+    ML_DSA_65_SEED_LENGTH as SEED_LEN, ML_DSA_65_SIGNATURE_LENGTH as SIG_LEN,
+};
+
+#[cfg(not(feature = "ml-dsa-lean"))]
+mod imp {
+    use super::*;
+    use aws_lc_rs::encoding::{AsRawBytes, PqdsaPrivateKeyRaw};
+    use aws_lc_rs::signature::{
+        KeyPair, ML_DSA_65, ML_DSA_65_SIGNING, PqdsaKeyPair, UnparsedPublicKey,
+    };
+
+    pub const NAME: &str = "aws-lc-rs";
+
+    pub fn verify(pk: &[u8; PK_LEN], msg: &[u8], sig: &[u8; SIG_LEN]) -> bool {
+        UnparsedPublicKey::new(&ML_DSA_65, &pk[..]).verify(msg, &sig[..]).is_ok()
+    }
+
+    pub fn sign(sk: &[u8; SK_LEN], msg: &[u8]) -> [u8; SIG_LEN] {
+        let kp = PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..])
+            .expect("invalid ML-DSA-65 raw private key");
+        let mut sig = [0u8; SIG_LEN];
+        let n = kp.sign(msg, &mut sig).expect("ML-DSA-65 sign failed");
+        debug_assert_eq!(n, SIG_LEN);
+        sig
+    }
+
+    pub fn public_key(sk: &[u8; SK_LEN]) -> [u8; PK_LEN] {
+        let kp = PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..])
+            .expect("invalid ML-DSA-65 raw private key");
+        let mut pk = [0u8; PK_LEN];
+        pk.copy_from_slice(kp.public_key().as_ref());
+        pk
+    }
+
+    pub fn secret_from_seed(seed: &[u8; SEED_LEN]) -> Result<[u8; SK_LEN], String> {
+        let kp = PqdsaKeyPair::from_seed(&ML_DSA_65_SIGNING, &seed[..])
+            .map_err(|err| err.to_string())?;
+        let raw: PqdsaPrivateKeyRaw<'static> =
+            kp.private_key().as_raw_bytes().map_err(|err| err.to_string())?;
+        <[u8; SK_LEN]>::try_from(raw.as_ref()).map_err(|err| err.to_string())
+    }
+
+    #[cfg(feature = "rand")]
+    pub fn generate_secret() -> [u8; SK_LEN] {
+        let kp = PqdsaKeyPair::generate(&ML_DSA_65_SIGNING).expect("ML-DSA-65 keygen failed");
+        let raw: PqdsaPrivateKeyRaw<'static> =
+            kp.private_key().as_raw_bytes().expect("ML-DSA-65 raw private export failed");
+        <[u8; SK_LEN]>::try_from(raw.as_ref()).expect("ML-DSA-65 raw private key length")
+    }
+
+    /// Accepts or rejects a raw private key at parse time (what `from_raw_private_key` did).
+    pub fn validate_secret(sk: &[u8; SK_LEN]) -> Result<(), String> {
+        PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..])
+            .map(|_| ())
+            .map_err(|err| err.to_string())
+    }
+}
+
+#[cfg(feature = "ml-dsa-lean")]
+mod imp {
+    use super::*;
+    use ml_dsa_lean::api::{keygen_65, pk_from_sk_65, sign_65, verify_65};
+
+    pub const NAME: &str = "ml-dsa-lean";
+
+    pub fn verify(pk: &[u8; PK_LEN], msg: &[u8], sig: &[u8; SIG_LEN]) -> bool {
+        verify_65(pk, msg, &[], sig)
+    }
+
+    /// Hedged (32 fresh random bytes) when the `rand` feature is on, as aws-lc signs; deterministic
+    /// (32 zero bytes) otherwise.
+    pub fn sign(sk: &[u8; SK_LEN], msg: &[u8]) -> [u8; SIG_LEN] {
+        let mut rnd = [0u8; 32];
+        #[cfg(feature = "rand")]
+        {
+            use secp256k1::rand::{RngCore, rngs::OsRng};
+            OsRng.fill_bytes(&mut rnd);
+        }
+        sign_65(sk, msg, &[], &rnd).expect("ML-DSA-65 sign failed")
+    }
+
+    pub fn public_key(sk: &[u8; SK_LEN]) -> [u8; PK_LEN] {
+        pk_from_sk_65(sk).expect("invalid ML-DSA-65 raw private key")
+    }
+
+    pub fn secret_from_seed(seed: &[u8; SEED_LEN]) -> Result<[u8; SK_LEN], String> {
+        Ok(keygen_65(seed).1)
+    }
+
+    #[cfg(feature = "rand")]
+    pub fn generate_secret() -> [u8; SK_LEN] {
+        use secp256k1::rand::{RngCore, rngs::OsRng};
+        let mut xi = [0u8; SEED_LEN];
+        OsRng.fill_bytes(&mut xi);
+        keygen_65(&xi).1
+    }
+
+    /// Accepts a raw private key iff it is internally consistent: s1 and s2 in range and (t0, tr)
+    /// match the key recomputed from (rho, s1, s2). See the trial README for how this compares with
+    /// what aws-lc accepts.
+    pub fn validate_secret(sk: &[u8; SK_LEN]) -> Result<(), String> {
+        pk_from_sk_65(sk).map(|_| ()).ok_or_else(|| "invalid ML-DSA-65 raw private key".to_string())
+    }
+}
+
+/// Name of the library behind ML-DSA-65 in this build.
+pub const ML_DSA_65_BACKEND: &str = imp::NAME;
+
+#[cfg(feature = "rand")]
+pub(crate) use imp::generate_secret;
+pub(crate) use imp::{public_key, secret_from_seed, sign, validate_secret, verify};
