+/// aws-lc's `UnparsedPublicKey` first tries to parse the key as a DER SubjectPublicKeyInfo. nearcore
+/// passes fixed 1952-byte arrays. A full SPKI for ML-DSA-65 is longer than 1952 bytes, so no 1952-byte
+/// input is a complete SPKI; check what aws-lc and the lean crate do with the obvious near-misses.
+#[test]
+fn der_spki_is_not_reachable_with_fixed_length_keys() {
+    let (pk, sk) = keygen_65(&[7; 32]);
+    let kp = PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..]).unwrap();
+    let der = kp.public_key().as_der().unwrap();
+    let der: &[u8] = der.as_ref();
+    println!(
+        "DER SPKI length for ML-DSA-65: {} bytes (raw pk is {PK}); header = {:02x?}",
+        der.len(),
+        &der[..24.min(der.len())]
+    );
+    assert!(der.len() > PK);
+    assert_eq!(&der[der.len() - PK..], &pk[..]);
+    let msg = b"der";
+    let sig = sign_65(&sk, msg, &[], &[0; 32]).unwrap();
+    // The full SPKI is accepted by aws-lc's verify entry point (a different, longer input).
+    let full_ok = UnparsedPublicKey::new(&ML_DSA_65, der).verify(msg, &sig[..]).is_ok();
+    println!("aws-lc accepts the {}-byte SPKI: {full_ok}", der.len());
+    // Every 1952-byte window of the SPKI and its truncations/paddings: none may be a different
+    // *accepting* key than the raw key for the same signature.
+    let mut accepted_other = 0;
+    for start in 0..=(der.len() - PK) {
+        let mut cand = [0u8; PK];
+        cand.copy_from_slice(&der[start..start + PK]);
+        let a = aws_verify(&cand, msg, &sig);
+        let l = lean_verify(&cand, msg, &sig);
+        assert_eq!(a, l, "window {start}");
+        if a && cand != pk {
+            accepted_other += 1;
+        }
+    }
+    // Header-prefixed truncation: header bytes then the first 1952 - header_len bytes of the key.
+    let hdr = der.len() - PK;
+    let mut trunc = [0u8; PK];
+    trunc[..hdr].copy_from_slice(&der[..hdr]);
+    trunc[hdr..].copy_from_slice(&pk[..PK - hdr]);
+    assert_eq!(aws_verify(&trunc, msg, &sig), lean_verify(&trunc, msg, &sig));
+    assert!(!aws_verify(&trunc, msg, &sig));
+    println!(
+        "1952-byte windows of the SPKI that aws-lc accepts as a different key: {accepted_other}"
+    );
+    assert_eq!(accepted_other, 0);
+}
+
+/// What each side accepts as a raw private key. aws-lc: `PqdsaKeyPair::from_raw_private_key`.
+/// lean: `sk_is_well_formed_65` (range check) and `pk_from_sk_65` (range check plus consistency).
+#[test]
+fn secret_key_acceptance() {
+    let mut rng = Rng(4);
+    let (pk0, sk0) = keygen_65(&[9; 32]);
+    let aws_ok =
+        |sk: &[u8; SK]| PqdsaKeyPair::from_raw_private_key(&ML_DSA_65_SIGNING, &sk[..]).is_ok();
+    let wf = |sk: &[u8; SK]| sk_is_well_formed_65(sk);
+    let cons = |sk: &[u8; SK]| pk_from_sk_65(sk).is_some();
+    // Layout: rho 0..32, K 32..64, tr 64..128, s1 128..768 (5*128), s2 768..1536 (6*128), t0 1536..4032 (6*416).
+    let region = |byte: usize| match byte {
+        0..32 => "rho",
+        32..64 => "K",
+        64..128 => "tr",
+        128..768 => "s1",
+        768..1536 => "s2",
+        _ => "t0",
+    };
+    use std::collections::BTreeMap;
+    let mut table: BTreeMap<&str, [u64; 5]> = BTreeMap::new(); // total, aws_ok, wf_ok, cons_ok, aws!=cons
+    let mut note = |name: &'static str, a: bool, w: bool, c: bool| {
+        let e = table.entry(name).or_default();
+        e[0] += 1;
+        e[1] += a as u64;
+        e[2] += w as u64;
+        e[3] += c as u64;
+        e[4] += (a != c) as u64;
+    };
+    note("valid key", aws_ok(&sk0), wf(&sk0), cons(&sk0));
+    for bit in 0..(SK * 8) {
+        if bit % 7 != 0 && bit / 8 >= 128 + 8 {
+            continue; // all bits of rho, K, tr and a sample of the rest
+        }
+        let mut sk = sk0;
+        sk[bit / 8] ^= 1 << (bit % 8);
+        note(region(bit / 8), aws_ok(&sk), wf(&sk), cons(&sk));
+    }
+    for _ in 0..200 {
+        let sk: [u8; SK] = rng.bytes();
+        note("random bytes", aws_ok(&sk), wf(&sk), cons(&sk));
+    }
+    for (name, sk) in [("all zero", [0u8; SK]), ("all 0xff", [0xffu8; SK])] {
+        note(name, aws_ok(&sk), wf(&sk), cons(&sk));
+    }
+    println!(
+        "secret_key_acceptance (rows: input class; columns: total, aws-lc accepts, lean well-formed, lean consistent, aws != consistent):"
+    );
+    for (k, v) in &table {
+        println!("  {k:12} {:6} {:6} {:6} {:6} {:6}", v[0], v[1], v[2], v[3], v[4]);
+    }
+    // If aws accepts a tampered key, the key it derives must match lean's pk_from_sk where lean accepts.
+    let _ = pk0;
+}
+
+#[test]
+fn near_crypto_public_api_roundtrip() {
+    let sk = SecretKey::from_random(KeyType::MLDSA65);
+    let pk = sk.public_key();
+    let msg = b"api-roundtrip";
+    let sig = sk.sign(msg);
+    assert!(sig.verify(msg, &pk));
+    assert!(!sig.verify(b"other", &pk));
+    // String round trip incl. secret key validation at parse time.
+    let parsed: SecretKey = sk.to_string().parse().unwrap();
+    assert_eq!(parsed.public_key(), pk);
+    // A corrupted secret key (a flipped bit in s1's first byte) must be rejected at parse time or
+    // report how it behaves; here only that parsing does not panic.
+    let text = sk.to_string();
+    let (_, b58) = text.split_once(':').unwrap();
+    let mut raw = bs58::decode(b58).into_vec().unwrap();
+    raw[200] ^= 0xff;
+    let s = format!("ml-dsa-65:{}", bs58::encode(raw).into_string());
+    println!(
+        "corrupted s1 byte, SecretKey::from_str -> is_err = {}",
+        s.parse::<SecretKey>().is_err()
+    );
+}
