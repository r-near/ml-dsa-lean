import Spec.Keccak

/-!
# Known-answer tests for `Spec.SHAKE128` / `Spec.SHAKE256`

The expected outputs are the `exp_<hash>_<message>_<outputBytes>` constants. They are also read by
`tests/shake_kat.rs`, which checks them against the Rust implementation in `src/keccak.rs`, so there is one
source of truth for the hex strings. Message tokens: `empty`, `abc`, `a3xN` (N bytes of 0xA3, the NIST example
for N = 200), `seqN` (the bytes `i % 251`, `i < N`). The values were produced with an independent SHAKE
implementation (Python `hashlib`); the empty-message values agree with the published NIST examples.
Message lengths around the rate (r - 1, r, r + 1) and output lengths around multiples of r exercise the
padding and multi-block squeezing.
-/

open Spec

def seqMsg (n : Nat) : List UInt8 := (List.range n).map fun i => (i % 251).toUInt8

def hex (l : List UInt8) : String :=
  String.join (l.map fun b =>
    String.singleton (Nat.digitChar (b.toNat / 16)) ++ String.singleton (Nat.digitChar (b.toNat % 16)))

