-- Prefix and length properties on concrete data
#guard SHAKE256 (seqMsg 300) 100 == (SHAKE256 (seqMsg 300) 777).take 100
#guard (SHAKE128 (seqMsg 300) 500).length == 500

/-! ### Timing: SHAKE256 on 1 kB input with 1 kB output, a batch of 100 small calls, raw permutations -/

#eval show IO Unit from do
  let t0 ← IO.monoMsNow
  let m := seqMsg (1000 + t0 * 0)  -- depends on a runtime value, so it is not evaluated at compile time
  let out := SHAKE256 m (1000 + t0 * 0)
  let s := out.foldl (fun a b => a + b.toNat) 0
  IO.println s!"checksum {s}"  -- forces the computation before the clock is read
  let t1 ← IO.monoMsNow
  IO.println s!"SHAKE256 1kB->1kB: {t1 - t0} ms"
  let mut tot := 0
  for i in [0:100] do
    tot := tot + (SHAKE256 (seqMsg (100 + i + t0 * 0)) 136).length
  IO.println s!"total length {tot}"
  let t3 ← IO.monoMsNow
  IO.println s!"100 x SHAKE256 (~100 B -> 136 B): {t3 - t1} ms"
  let mut st := Spec.Keccak.zeroState
  for _ in [0:100] do
    st := Spec.KeccakF1600 st
  IO.println s!"lane 0: {st[0]!}"
  let t4 ← IO.monoMsNow
  IO.println s!"100 x Keccak-f[1600]: {t4 - t3} ms"
