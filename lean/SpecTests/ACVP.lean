import Spec
import SpecTests.ACVPData

/-!
# ACVP cross-check of the FIPS 204 specification (`lean/Spec`)

An executable (`lake build spec-acvp && .lake/build/bin/spec-acvp`): runs the specification on the NIST ACVP
vectors in `SpecTests/ACVPData.lean` (generated by `scripts/gen-lean-acvp.py`) and compares the output bytes.

* keyGen: `Spec.KeyGen_internal` against the expected `pk` and `sk`.
* sigGen: `Spec.Sign_internal` (interface `internal`, the message is M′) or `Spec.Sign` (interface `external`),
  deterministic and hedged, against the expected signature.
* sigVer: `Spec.Verify_internal` or `Spec.Verify`, against the expected verdict (valid and modified
  message / commitment / z / hint cases).

The exit code is 0 iff every case agrees.
-/

open Spec SpecTests.ACVP

def hexVal (c : Char) : Nat :=
  if c.isDigit then c.toNat - '0'.toNat
  else if 'a' ≤ c ∧ c ≤ 'f' then c.toNat - 'a'.toNat + 10
  else c.toNat - 'A'.toNat + 10

/-- Decode a hex string into bytes. -/
def unhex (s : String) : List UInt8 :=
  let cs := s.toList.toArray
  (List.range (cs.size / 2)).map fun i => (hexVal cs[2 * i]! * 16 + hexVal cs[2 * i + 1]!).toUInt8

def paramsOf (set : String) : Params :=
  if set == "ML-DSA-44" then ML_DSA_44
  else if set == "ML-DSA-65" then ML_DSA_65
  else ML_DSA_87

/-- Run `act`, return its result and the elapsed milliseconds. -/
def timed {α : Type} (act : Unit → α) : IO (α × Nat) := do
  let t0 ← IO.monoMsNow
  let r := act ()
  -- force the result before reading the clock
  let r ← IO.lazyPure fun _ => r
  let t1 ← IO.monoMsNow
  pure (r, t1 - t0)

def main : IO UInt32 := do
  let mut failures := 0
  let mut total := 0
  -- keyGen
  for c in keyGenCases do
    let p := paramsOf c.set
    let (r, ms) ← timed fun _ => KeyGen_internal p (unhex c.seed)
    let ok := r == some (unhex c.pk, unhex c.sk)
    total := total + 1
    if !ok then failures := failures + 1
    IO.println s!"keyGen  {c.set} tc {c.tcId}: {if ok then "ok" else "FAIL"} ({ms} ms)"
  -- sigGen
  for c in sigGenCases do
    let p := paramsOf c.set
    let sk := unhex c.sk
    let rnd := unhex c.rnd
    let (r, ms) ← timed fun _ =>
      if c.interface == "internal" then Sign_internal p sk (unhex c.message) rnd
      else Sign p sk (unhex c.message) (unhex c.context) rnd
    let ok := r == some (unhex c.signature)
    total := total + 1
    if !ok then failures := failures + 1
    IO.println s!"sigGen  {c.set} tc {c.tcId} {c.interface} {if c.deterministic then "det" else "hedged"}: {if ok then "ok" else "FAIL"} ({ms} ms)"
  -- sigVer
  for c in sigVerCases do
    let p := paramsOf c.set
    let (r, ms) ← timed fun _ =>
      if c.interface == "internal" then
        Verify_internal p (unhex c.pk) (unhex c.message) (unhex c.signature)
      else Verify p (unhex c.pk) (unhex c.message) (unhex c.signature) (unhex c.context)
    let ok := r == some c.expected
    total := total + 1
    if !ok then failures := failures + 1
    IO.println s!"sigVer  {c.set} tc {c.tcId} {c.interface} expect {c.expected} ({c.reason}): {if ok then "ok" else "FAIL"} ({ms} ms)"
  IO.println s!"{total - failures}/{total} cases agree"
  return (if failures == 0 then 0 else 1)
