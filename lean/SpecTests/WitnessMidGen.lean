import Spec.MLDSA

/-!
# Intermediate values for the piecewise kernel checks of the non-vacuity witnesses (ML-DSA-44)

`SpecTests/WitnessGen.lean` prints the end values of the `KeyGen` / first-`Sign`-attempt chain
(`Proofs/TopWitnessData.lean`). The heavy kernel stage lemmas are checked piece by piece, so this program prints the values
at the piece boundaries as well: the polynomial after a given number of NTT layers, and the Keccak state after a given
number of absorbed blocks. Nothing printed here is trusted: the kernel re-derives every piece
(`Proofs/TopWitnessMid.lean` is imported by the stage modules generated by `scripts/gen-witness-stages.py`).

Usage (from `lean/`): `lake env lean --run SpecTests/WitnessMidGen.lean > Proofs/TopWitnessMid.lean`
(`lake env lean --run SpecTests/WitnessMidGen.lean all` prints every layer and every block boundary, for measuring).
The cut lists below must equal `FWD_CUTS`, `INV_CUTS`, `TR_CUTS`, `CT_CUTS` of `scripts/gen-witness-stages.py`. The program
also prints the number of hints of each polynomial of the first signing attempt (`hint_n_i`), for the hint-weight check.
-/

open Spec

/-- Layer counts after which a forward NTT is cut (a piece is the layers between two cuts). -/
def fwdCuts : List Nat := [2, 4, 6]
/-- Layer counts after which an inverse NTT is cut (8: after the last layer, before the scaling by `256⁻¹`). -/
def invCuts : List Nat := [2, 4, 6, 8]
/-- Block counts after which `H(pk, 64)` and `H(μ ‖ w1, λ/4)` are cut. -/
def trCuts : List Nat := [3, 6, 9]
def ctCuts : List Nat := [3, 6]

def showNats (l : List Nat) : String := "[" ++ ", ".intercalate (l.map toString) ++ "]"
def polyN (p : Poly) : List Nat := p.toList.map ZMod.val

/-- The polynomial and the twiddle counter after the first `k` layers of the forward NTT. -/
def fwdState (w : Poly) (k : Nat) : Poly × Nat :=
  (List.range k).foldl (fun p i => nttLayer (128 >>> i) p.1 p.2) (w, 0)

/-- The polynomial and the twiddle counter after the first `k` layers of the inverse NTT (before the scaling). -/
def invState (w : Poly) (k : Nat) : Poly × Nat :=
  (List.range k).foldl (fun p i => nttInvLayer (1 <<< i) p.1 p.2) (w, 256)

/-- The Keccak state after absorbing the first `k` blocks of `pad101 136 M`. -/
def spongeState (M : List UInt8) (k : Nat) : Keccak.State :=
  let P := Keccak.pad101 136 M
  (List.range k).foldl (fun S i => KeccakF1600 (Keccak.xorBlock S ((P.drop (136 * i)).take 136))) Keccak.zeroState

def emitFwd (all : Bool) (name : String) (w : Poly) : IO Unit := do
  for k in (if all then List.range 8 |>.drop 1 else fwdCuts) do
    IO.println s!"def nf_{name}_c{k} : List Nat := {showNats (polyN (fwdState w k).1)}\n"

def emitInv (all : Bool) (name : String) (w : Poly) : IO Unit := do
  for k in (if all then List.range 9 |>.drop 1 else invCuts) do
    IO.println s!"def ni_{name}_c{k} : List Nat := {showNats (polyN (invState w k).1)}\n"

def emitSponge (all : Bool) (name : String) (M : List UInt8) (cuts : List Nat) : IO Unit := do
  let n := (Keccak.pad101 136 M).length / 136
  for k in (if all then List.range n |>.drop 1 else cuts) do
    let S := spongeState M k
    IO.println s!"def h_{name}_c{k} : List Nat := {showNats (S.toList.map UInt64.toNat)}\n"

def main (args : List String) : IO Unit := do
  let all := args == ["all"]
  let p := ML_DSA_44
  let xi : List UInt8 := (List.range 32).map Nat.toUInt8
  let out := H (xi ++ IntegerToBytes p.k 1 ++ IntegerToBytes p.ℓ 1) 128
  let rho := slice out 0 32
  let rho1 := slice out 32 64
  let K := slice out 96 32
  let some A := ExpandA p 512 rho | throw (IO.userError "ExpandA")
  let some (s1, s2) := ExpandS p 512 rho1 | throw (IO.userError "ExpandS")
  let s1h := NTTVec (s1.map RPoly.toZq)
  let mv := MatrixVectorNTT A s1h
  let t := NTTInvVec mv + s2.map RPoly.toZq
  let (t1, t0) := Power2RoundVec p t
  let pk := pkEncode p rho t1
  let tr := H pk 64
  let M' : List UInt8 := IntegerToBytes 0 1 ++ IntegerToBytes ([] : List UInt8).length 1 ++ [] ++ [0]
  let rnd : List UInt8 := List.replicate 32 0
  let mu := H (tr ++ M') 64
  let rho2 := H (K ++ rnd ++ mu) 64
  let s2h := NTTVec (s2.map RPoly.toZq)
  let t0h := NTTVec (t0.map RPoly.toZq)
  let yR := ExpandMask p rho2 0
  let y := yR.map RPoly.toZq
  let yh := NTTVec y
  let wmv := MatrixVectorNTT A yh
  let w := NTTInvVec wmv
  let w1 := HighBitsVec p w
  let w1b := w1Encode p w1
  let ct := H (mu ++ w1b) (p.lam / 4)
  let some c := SampleInBall p 512 ct | throw (IO.userError "SampleInBall")
  let ch := NTT c.toZq
  let cs2 := NTTInvVec (ScalarVectorNTT ch s2h)
  let ct0 := NTTInvVec (ScalarVectorNTT ch t0h)
  let hint := MakeHintVec p (-ct0) (w - cs2 + ct0)
  IO.println "-- GENERATED by SpecTests/WitnessMidGen.lean (run from lean/); do not edit by hand.\n"
  IO.println "/-! The values at the piece boundaries of the heavy kernel stage lemmas (ML-DSA-44, `ξ = 0, 1, ..., 31`). Candidate"
  IO.println "values only: the kernel re-derives each one. See `SpecTests/WitnessMidGen.lean`. -/\n"
  IO.println "namespace Proofs.TopWitness.Mid\n"
  for i in [0:4] do emitFwd all s!"s1_{i}" (s1[i]!.toZq)
  for i in [0:4] do emitFwd all s!"s2_{i}" (s2[i]!.toZq)
  for i in [0:4] do emitFwd all s!"t0_{i}" (t0[i]!.toZq)
  for i in [0:4] do emitFwd all s!"y_{i}" y[i]!
  emitFwd all "c" c.toZq
  for i in [0:4] do emitInv all s!"t_{i}" mv[i]!
  for i in [0:4] do emitInv all s!"w_{i}" wmv[i]!
  for i in [0:4] do emitInv all s!"cs1_{i}" (Vector.zipWith (· * ·) ch s1h[i]!)
  for i in [0:4] do emitInv all s!"cs2_{i}" (Vector.zipWith (· * ·) ch s2h[i]!)
  for i in [0:4] do emitInv all s!"ct0_{i}" (Vector.zipWith (· * ·) ch t0h[i]!)
  for i in [0:4] do
    IO.println s!"def hint_n_{i} : Nat := {(hint[i]!).countP (fun b => b)}\n"
  emitSponge all "tr" pk trCuts
  emitSponge all "ct" (mu ++ w1b) ctCuts
  IO.println "end Proofs.TopWitness.Mid"
