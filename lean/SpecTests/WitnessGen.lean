import Spec.MLDSA

/-!
# Candidate literals for the Sign/KeyGen non-vacuity witnesses (ML-DSA-44)

Runs the specification natively on `ξ = 0, 1, ..., 31`, `rnd = 0^32`, `M = [0]`, `ctx = []` and prints the
intermediate values of `KeyGen` and of the first attempt of `Sign` as Lean definitions. The output is the
generated module `Proofs/TopWitnessData.lean`. Nothing printed here is trusted: the kernel re-derives every
value (`Proofs/TopWitness*.lean`).

Usage (from `lean/`): `lake env lean --run SpecTests/WitnessGen.lean > Proofs/TopWitnessData.lean`
-/

open Spec

def showNats (l : List Nat) : String := "[" ++ ", ".intercalate (l.map toString) ++ "]"
def showInts (l : List Int) : String := "[" ++ ", ".intercalate (l.map toString) ++ "]"
def showBytes (l : List UInt8) : String := showNats (l.map UInt8.toNat)

def polyN (p : Poly) : List Nat := p.toList.map ZMod.val
def rpolyI (p : RPoly) : List Int := p.toList

def emitN (name : String) (l : List Nat) : IO Unit :=
  IO.println s!"def {name} : List Nat := {showNats l}\n"
def emitI (name : String) (l : List Int) : IO Unit :=
  IO.println s!"def {name} : List Int := {showInts l}\n"
def emitB (name : String) (l : List UInt8) : IO Unit :=
  IO.println s!"def {name} : List UInt8 := {showNats (l.map UInt8.toNat)}\n"

def emitVecN {n : Nat} (name : String) (v : Vector Poly n) : IO Unit := do
  for i in [0:n] do emitN s!"{name}_{i}" (polyN v[i]!)
def emitVecI {n : Nat} (name : String) (v : Vector RPoly n) : IO Unit := do
  for i in [0:n] do emitI s!"{name}_{i}" (rpolyI v[i]!)

def main : IO Unit := do
  let p := ML_DSA_44
  let xi : List UInt8 := (List.range 32).map Nat.toUInt8
  let out := H (xi ++ IntegerToBytes p.k 1 ++ IntegerToBytes p.ℓ 1) 128
  let rho := slice out 0 32
  let rho1 := slice out 32 64
  let K := slice out 96 32
  let some A := ExpandA p 512 rho | throw (IO.userError "ExpandA")
  let some (s1, s2) := ExpandS p 512 rho1 | throw (IO.userError "ExpandS")
  let s1h := NTTVec (s1.map RPoly.toZq)
  let mv := MatrixVectorNTT A s1h
  let t := NTTInvVec mv + s2.map RPoly.toZq
  let (t1, t0) := Power2RoundVec p t
  let pk := pkEncode p rho t1
  let tr := H pk 64
  let M' : List UInt8 := IntegerToBytes 0 1 ++ IntegerToBytes ([] : List UInt8).length 1 ++ [] ++ [0]
  let rnd : List UInt8 := List.replicate 32 0
  let mu := H (tr ++ M') 64
  let rho2 := H (K ++ rnd ++ mu) 64
  let s2h := NTTVec (s2.map RPoly.toZq)
  let t0h := NTTVec (t0.map RPoly.toZq)
  -- first attempt, κ = 0
  let ybytes : List (List UInt8) := (List.range p.ℓ).map fun r => H (rho2 ++ IntegerToBytes (0 + r) 2) (32 * (1 + bitlen (p.γ₁ - 1)))
  let yR := ExpandMask p rho2 0
  let y := yR.map RPoly.toZq
  let yh := NTTVec y
  let wmv := MatrixVectorNTT A yh
  let w := NTTInvVec wmv
  let w1 := HighBitsVec p w
  let w1b := w1Encode p w1
  let ct := H (mu ++ w1b) (p.lam / 4)
  let some c := SampleInBall p 512 ct | throw (IO.userError "SampleInBall")
  let ch := NTT c.toZq
  let cs1 := NTTInvVec (ScalarVectorNTT ch s1h)
  let cs2 := NTTInvVec (ScalarVectorNTT ch s2h)
  let ct0 := NTTInvVec (ScalarVectorNTT ch t0h)
  let z := y + cs1
  let r0 := LowBitsVec p (w - cs2)
  let ok1 := !(decide (‖z‖∞ ≥ p.γ₁ - p.β ∨ ‖r0‖∞ ≥ p.γ₂ - p.β))
  let h := MakeHintVec p (-ct0) (w - cs2 + ct0)
  let ok2 := !(decide (‖ct0‖∞ ≥ p.γ₂ ∨ HintWeight h > p.ω))
  IO.eprintln s!"attempt 0 accepted: {ok1 && ok2}  (norm test {ok1}, hint test {ok2}), |z| {‖z‖∞}, |r0| {‖r0‖∞}, |ct0| {‖ct0‖∞}, weight {HintWeight h}"
  let sk := skEncode p rho K tr s1 s2 t0
  let sig := Sign p sk [0] [] rnd {}
  IO.eprintln s!"Sign isSome: {sig.isSome}, KeyGen isSome: {(KeyGen p xi {}).isSome}"
  IO.println "import Proofs.TopWitnessFast\n"
  IO.println "/-! Generated by `SpecTests/WitnessGen.lean` (see there). Candidate values only: the kernel re-derives each one. -/\n"
  IO.println "namespace Proofs.TopWitness.Data\n"
  emitB "kL" K
  for r in [0:p.k] do
    for s in [0:p.ℓ] do emitN s!"a_{r}_{s}" (polyN A[r]![s]!)
  emitVecI "s1" s1
  emitVecI "s2" s2
  emitVecN "s1h" s1h
  emitVecN "mv" mv
  emitVecN "t" t
  emitVecI "t1" t1
  emitVecI "t0" t0
  emitB "pkL" pk
  emitB "trL" tr
  emitB "muL" mu
  emitB "rho2L" rho2
  emitVecN "s2h" s2h
  emitVecN "t0h" t0h
  for r in [0:p.ℓ] do emitB s!"yb_{r}" ybytes[r]!
  emitVecI "yr" yR
  emitVecN "y" y
  emitVecN "yh" yh
  emitVecN "wmv" wmv
  emitVecN "w" w
  emitVecI "w1" w1
  emitB "w1bL" w1b
  emitB "ctL" ct
  emitI "cL" (rpolyI c)
  emitN "ch" (polyN ch)
  emitVecN "cs1" cs1
  emitVecN "cs2" cs2
  emitVecN "ct0" ct0
  IO.println "end Proofs.TopWitness.Data"
