import Spec
import SpecTests.WycheproofData

/-!
# Wycheproof cross-check of the FIPS 204 specification (`lean/Spec`)

An executable (`lake build spec-wycheproof && .lake/build/bin/spec-wycheproof`): runs the specification on the Wycheproof
ML-DSA vectors in `SpecTests/WycheproofData.lean` (generated by `scripts/gen-lean-wycheproof.py` from the vendored files in
`tests/data/wycheproof`) and compares with the expected results.

* verify: `Spec.Verify` (Algorithm 3) on every case of the three `mldsa_*_verify_test.json` files, against the expected
  verdict (`valid` = `some true`, `invalid` = `some false`). Wrong-length keys / signatures, over-long contexts, malformed
  hints and out-of-range `z` must all give `some false`.
* sign (every message-bearing case of the `mldsa_*_sign_seed_test.json` files): `Spec.KeyGen_internal` on the seed must give
  the group public key; `Spec.Sign` must give the expected signature bytes, or `none` for a context longer than 255 bytes.
  Cases that carry only `mu` (flag `Internal`) are not run: the specification has no external-mu entry point.
* `InvalidPrivateKey` (sign_noseed): informational only, see `runBadKeys`.

The exit code is 0 iff every case agrees. Run `spec-wycheproof verify` or `spec-wycheproof sign` to run one part only.
-/

open Spec SpecTests.Wycheproof

def hexVal (c : Char) : Nat :=
  if c.isDigit then c.toNat - '0'.toNat
  else if 'a' ≤ c ∧ c ≤ 'f' then c.toNat - 'a'.toNat + 10
  else c.toNat - 'A'.toNat + 10

/-- Decode a hex string into bytes. -/
def unhex (s : String) : List UInt8 :=
  let cs := s.toList.toArray
  (List.range (cs.size / 2)).map fun i => (hexVal cs[2 * i]! * 16 + hexVal cs[2 * i + 1]!).toUInt8

def paramsOf (set : String) : Params :=
  if set == "ML-DSA-44" then ML_DSA_44
  else if set == "ML-DSA-65" then ML_DSA_65
  else ML_DSA_87

/-- Run `act`, return its result and the elapsed milliseconds. -/
def timed {α : Type} (act : Unit → α) : IO (α × Nat) := do
  let t0 ← IO.monoMsNow
  let r := act ()
  -- force the result before reading the clock
  let r ← IO.lazyPure fun _ => r
  let t1 ← IO.monoMsNow
  pure (r, t1 - t0)

/-- Per-parameter-set counters: (pass, fail). -/
abbrev Counts := Array (String × Nat × Nat)

def bump (cs : Counts) (key : String) (ok : Bool) : Counts :=
  match cs.findIdx? (·.1 == key) with
  | some i => cs.modify i fun (k, p, f) => if ok then (k, p + 1, f) else (k, p, f + 1)
  | none => cs.push (key, if ok then 1 else 0, if ok then 0 else 1)

def runVerify (verbose : Bool) : IO (Counts × Nat) := do
  let mut counts : Counts := #[]
  let mut failures := 0
  for g in verifyGroups do
    let p := paramsOf g.set
    let pk := unhex g.pk
    for c in g.cases do
      let (r, ms) ← timed fun _ => Verify p pk (unhex c.msg) (unhex c.sig) (unhex c.ctx)
      let ok := r == some c.expected
      counts := bump counts s!"verify {g.set}" ok
      if !ok then failures := failures + 1
      if verbose || !ok then
        IO.println s!"verify  {g.set} group {g.group} tc {c.tcId} expect {c.expected} [{c.flags}] ({c.comment}): {if ok then "ok" else s!"FAIL (got {repr r})"} ({ms} ms)"
  return (counts, failures)

def runSign (verbose : Bool) : IO (Counts × Nat) := do
  let mut counts : Counts := #[]
  let mut failures := 0
  for g in signGroups do
    let p := paramsOf g.set
    let (kg, ms1) ← timed fun _ => KeyGen_internal p (unhex g.seed)
    let pkOk := g.pk == "" || (kg.map (·.1)) == some (unhex g.pk)
    counts := bump counts s!"keyGen {g.set}" pkOk
    if !pkOk then failures := failures + 1
    if verbose || !pkOk then
      IO.println s!"keyGen  {g.set} group {g.group}: {if pkOk then "ok" else "FAIL"} ({ms1} ms)"
    match kg with
    | none =>
      IO.println s!"keyGen  {g.set} group {g.group}: FAIL (KeyGen_internal ran out of fuel)"
      failures := failures + 1
    | some (_, sk) =>
      for c in g.cases do
        let (r, ms) ← timed fun _ => Sign p sk (unhex c.msg) (unhex c.ctx) (unhex c.rnd)
        let ok := if c.expected then r == some (unhex c.sig) else r == none
        counts := bump counts s!"sign {g.set}" ok
        if !ok then failures := failures + 1
        if verbose || !ok then
          IO.println s!"sign    {g.set} group {g.group} tc {c.tcId} expect {c.expected} [{c.flags}] ({c.comment}): {if ok then "ok" else "FAIL"} ({ms} ms)"
  return (counts, failures)

/-- The `InvalidPrivateKey` vectors expect signing to fail. FIPS 204 does not require that (skDecode is defined on such bytes
and "should only be run on inputs that come from trusted sources"), so the specification, like `ml-dsa-verified`, signs.
This prints what the specification does; it never counts as a failure. A signature that verifies is reported as `signs`. -/
def runBadKeys (verbose : Bool) : IO Unit := do
  let mut signs := 0
  let mut refuses := 0
  for c in badKeyCases do
    let p := paramsOf c.set
    let (r, ms) ← timed fun _ => Sign p (unhex c.sk) (unhex c.msg) (unhex c.ctx) (List.replicate 32 0)
    match r with
    | some _ => signs := signs + 1
    | none => refuses := refuses + 1
    if verbose then
      IO.println s!"badKey  {c.set} tc {c.tcId} [{c.flags}] ({c.comment}): {if r.isSome then "spec signs (vector expects failure)" else "spec refuses"} ({ms} ms)"
  IO.println s!"InvalidPrivateKey (informational): spec signs {signs}, refuses {refuses} of {badKeyCases.size}"

def report (counts : Counts) : IO Unit := do
  for (k, p, f) in counts do
    IO.println s!"{k}: {p} agree, {f} disagree"

def main (args : List String) : IO UInt32 := do
  let verbose := args.contains "-v" || args.contains "--verbose"
  let doVerify := !args.contains "sign"
  let doSign := !args.contains "verify"
  let mut failures := 0
  let mut total := 0
  if doVerify then
    let (cs, f) ← runVerify verbose
    report cs
    failures := failures + f
    total := total + cs.foldl (fun n (_, p, f) => n + p + f) 0
  if doSign then
    let (cs, f) ← runSign verbose
    report cs
    failures := failures + f
    total := total + cs.foldl (fun n (_, p, f) => n + p + f) 0
    runBadKeys verbose
  IO.println s!"{total - failures}/{total} cases agree"
  return (if failures == 0 then 0 else 1)
