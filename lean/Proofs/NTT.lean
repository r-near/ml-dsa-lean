/-!
# Forward NTT: the extracted Rust equals FIPS 204 Algorithm 41
-/

open Aeneas Aeneas.Std RustM
open Spec
set_option maxRecDepth 8192

namespace Proofs
open Impl

/-! ## The inner loop (Algorithm 41, steps 9-12) -/

/-- One iteration of the inner `for j` loop of `nttLayer`, as a function of the polynomial. -/
def bfly (len : Nat) (z : Zq) (w : Poly) (j : Nat) : Poly :=
  (w.set! (j + len) (w[j]! - z * w[j + len]!)).set! j
    ((w.set! (j + len) (w[j]! - z * w[j + len]!))[j]! + z * w[j + len]!)

theorem toZq_bfly (w : Array U32 256#usize) (LEN : Nat) (z : U32) (j i1 : Usize) (t i4 i6 : U32)
    (hLEN : 0 < LEN) (hj : j.val + LEN < 256) (hi1 : i1.val = j.val + LEN)
    (h1 : i1.val < w.val.length) (h2 : j.val < w.val.length)
    (h3 : j.val < (w.set i1 i4).val.length)
    (ht : ((t.val : Nat) : Zq) = (z.val : Zq) * ((w.val[i1.val]).val : Nat))
    (h4 : ((i4.val : Nat) : Zq) = ((w.val[j.val]).val : Nat) - (t.val : Nat))
    (h6 : ((i6.val : Nat) : Zq) = (((w.set i1 i4).val[j.val]).val : Nat) + (t.val : Nat)) :
    toZq ((w.set i1 i4).set j i6) = bfly LEN (z.val : Zq) (toZq w) j.val := by
  have hj256 : j.val < 256 := by omega
  have hi256 : i1.val < 256 := by omega
  have hne : i1.val ≠ j.val := by omega
  have hW1 : (toZq w)[j.val + LEN]! = (((w.val[i1.val]).val : Nat) : Zq) := by
    rw [← hi1]; exact toZq_getElem w _ h1
  have hW2 : (toZq w)[j.val]! = (((w.val[j.val]).val : Nat) : Zq) := toZq_getElem w _ h2
  have hset : (w.set i1 i4).val[j.val] = w.val[j.val] := by
    simp [Array.set_val_eq, List.getElem_set_ne hne]
  rw [toZq_set _ _ _ hj256, toZq_set _ _ _ hi256, bfly, vec_getElem!_set!_ne _ _ hj256 (by omega)]
  rw [hi1] at *
  rw [hset] at h6
  rw [ht] at h4
  rw [h4, h6, hW1, hW2]
  rw [ht]

@[step]
theorem inner_loop (LEN start : Usize) (z zp : U32) (hzp : zp.val = z.val * 4294967296 / 8380417)
    (hLEN : 0 < LEN.val) (hfit : start.val + 2 * LEN.val ≤ 256)
    (w0 : Array U32 256#usize) (hw0 : Canonical w0) :
    ntt.ntt_layer_loop0_loop0 LEN w0 start z zp start ⦃ w =>
      Canonical w ∧
      toZq w = (List.range' start.val LEN.val).foldl (bfly LEN.val (z.val : Zq)) (toZq w0) ⦄ := by
  unfold ntt.ntt_layer_loop0_loop0
  apply loop.spec_decr_nat
    (fun (p : Array U32 256#usize × Usize) => start.val + LEN.val - p.2.val)
    (fun p => Canonical p.1 ∧ start.val ≤ p.2.val ∧ p.2.val ≤ start.val + LEN.val ∧
       toZq p.1 = (List.range' start.val (p.2.val - start.val)).foldl
         (bfly LEN.val (z.val : Zq)) (toZq w0))
  · rintro ⟨w, j⟩ ⟨hc, h1, h2, h3⟩
    dsimp only at hc h1 h2 h3
    simp only [ntt.ntt_layer_loop0_loop0.body]
    step*
    all_goals try subst_vars
    all_goals try exact canon_get hc _
    all_goals try exact canon_get (canonical_set _ _ _ hc ‹_›) _
    have hb := toZq_bfly w LEN.val z j i1 t i4 i6 hLEN (by scalar_tac) i1_post i2 i3 i5
      t_post2 i4_post2 i6_post2
    refine ⟨canonical_set _ _ _ (canonical_set _ _ _ hc i4_post1) i6_post1, by omega, by scalar_tac,
      ?_, by scalar_tac⟩
    rw [hb, h3, show j1.val - start.val = (j.val - start.val) + 1 by omega, List.range'_concat,
      List.foldl_append, List.foldl_cons, List.foldl_nil,
      show start.val + 1 * (j.val - start.val) = j.val by omega]
  · refine ⟨hw0, le_refl _, by simp, by simp⟩

/-! ## Twiddle table -/

/-- The literal `ZETAS` table is `1753^BitRev8(k) mod q`, checked by kernel evaluation. -/
theorem zetas_nat : ∀ k : Fin 256,
    (ntt.ZETAS.val[k.val]!).val = 1753 ^ Spec.BitRev8 k.val % 8380417 := by
  decide +kernel

theorem zeta_eq_nat (k : Nat) : zeta k = ((1753 ^ Spec.BitRev8 k % 8380417 : Nat) : Zq) := by
  simp [zeta, ζ, ZMod.natCast_mod]

theorem zetas_get (k : Usize) (hk : k.val < 256) (hlt : k.val < ntt.ZETAS.val.length) (z : U32)
    (hz : z = ntt.ZETAS.val[k.val]) :
    z.val < Spec.q ∧ ((z.val : Nat) : Zq) = zeta k.val := by
  have h := zetas_nat ⟨k.val, hk⟩
  simp only [List.getElem!_eq_getElem?_getD, List.getElem?_eq_getElem hlt, Option.getD_some] at h
  rw [hz]
  refine ⟨?_, ?_⟩
  · rw [h]; exact Nat.mod_lt _ (by decide)
  · rw [h, zeta_eq_nat]

/-! ### The Shoup companions

`ZETAS_SHOUP[k] = ⌊ZETAS[k]·2³²/q⌋`, `ZETAS_NEG_SHOUP[k] = ⌊(q − ZETAS[k])·2³²/q⌋` (the twiddles of NTT⁻¹ are
`q − ZETAS[k]`) and `F_SHOUP = ⌊256⁻¹·2³²/q⌋`, checked by kernel evaluation. The tables are generated by
`scripts/gen-ntt-tables.py`, but nothing here trusts the generator. -/

theorem shoup_tables : ∀ k : Fin 256,
    0 < (ntt.ZETAS.val[k.val]!).val ∧
    (ntt.ZETAS_SHOUP.val[k.val]!).val = (ntt.ZETAS.val[k.val]!).val * 4294967296 / 8380417 ∧
    (ntt.ZETAS_NEG_SHOUP.val[k.val]!).val =
      (8380417 - (ntt.ZETAS.val[k.val]!).val) * 4294967296 / 8380417 := by
  decide +kernel

theorem f_shoup_eq : ntt.F_SHOUP.val = (8347681#u32).val * 4294967296 / 8380417 := by
  decide +kernel

theorem zetas_shoup_get (k : Usize) (hk : k.val < 256) (hlt : k.val < ntt.ZETAS.val.length)
    (hlt2 : k.val < ntt.ZETAS_SHOUP.val.length) (z zp : U32)
    (hz : z = ntt.ZETAS.val[k.val]) (hzp : zp = ntt.ZETAS_SHOUP.val[k.val]) :
    zp.val = z.val * 4294967296 / 8380417 := by
  have h := (shoup_tables ⟨k.val, hk⟩).2.1
  simp only [List.getElem!_eq_getElem?_getD, List.getElem?_eq_getElem hlt,
    List.getElem?_eq_getElem hlt2, Option.getD_some] at h
  rw [hz, hzp]
  exact h

/-- The twiddle of NTT⁻¹ is `z = 0 − ZETAS[k]` (`field.sub 0 _`), a residue `< q` congruent to `−ZETAS[k]`; its
companion table entry is `⌊z·2³²/q⌋`. -/
theorem zetas_neg_shoup_get (k : Usize) (hk : k.val < 256) (hlt : k.val < ntt.ZETAS.val.length)
    (hlt2 : k.val < ntt.ZETAS_NEG_SHOUP.val.length) (zz zp z : U32)
    (hzz : zz = ntt.ZETAS.val[k.val]) (hzp : zp = ntt.ZETAS_NEG_SHOUP.val[k.val])
    (hz1 : z.val < 8380417)
    (hz2 : (z.val : ZMod 8380417) = ((0#u32).val : ZMod 8380417) - (zz.val : ZMod 8380417)) :
    zp.val = z.val * 4294967296 / 8380417 := by
  have h := shoup_tables ⟨k.val, hk⟩
  have h0 := h.1
  have h2 := h.2.2
  have hzlt : (ntt.ZETAS.val[k.val]!).val < 8380417 := by
    have := zetas_nat ⟨k.val, hk⟩
    rw [this]; exact Nat.mod_lt _ (by decide)
  simp only [List.getElem!_eq_getElem?_getD, List.getElem?_eq_getElem hlt,
    List.getElem?_eq_getElem hlt2, Option.getD_some] at h0 h2 hzlt
  have hzz' : zz.val = (ntt.ZETAS.val[k.val]).val := by rw [hzz]
  have hcast : (z.val : ZMod 8380417) = ((8380417 - zz.val : Nat) : ZMod 8380417) := by
    rw [hz2, Nat.cast_sub (by omega)]
    have hq : ((8380417 : Nat) : ZMod 8380417) = 0 := ZMod.natCast_self _
    rw [hq]; simp
  have hmod := (ZMod.natCast_eq_natCast_iff' _ _ _).mp hcast
  rw [Nat.mod_eq_of_lt hz1, Nat.mod_eq_of_lt (by omega)] at hmod
  rw [hzp, h2, ← hzz', hmod]

/-! ## One layer (Algorithm 41, steps 5-13) -/

/-- One iteration of the block loop `while start < 256`, on the state `(m, start, ŵ)`. -/
def blockF (len : Nat) (b : MProd Nat (MProd Nat Poly)) (_a : Nat) : MProd Nat (MProd Nat Poly) :=
  ⟨b.fst + 1, b.snd.fst + 2 * len,
    (List.range' b.snd.fst len).foldl (bfly len (zeta (b.fst + 1))) b.snd.snd⟩

/-- The block loop state after `i` blocks. -/
def blockFold (len m0 : Nat) (w0 : Poly) (i : Nat) : MProd Nat (MProd Nat Poly) :=
  (List.range' 0 i).foldl (blockF len) ⟨m0, 0, w0⟩

theorem nttLayer_eq (len : Nat) (w : Poly) (m : Nat) :
    nttLayer len w m =
      ((blockFold len m w (256 / (2 * len))).snd.snd, (blockFold len m w (256 / (2 * len))).fst) := by
  unfold nttLayer blockFold
  simp [Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size]
  constructor <;> rfl

theorem blockFold_succ (len m0 : Nat) (w0 : Poly) (i : Nat) :
    blockFold len m0 w0 (i + 1) = blockF len (blockFold len m0 w0 i) i := by
  simp [blockFold, List.range'_concat, List.foldl_append]

theorem blockFold_zero (len m0 : Nat) (w0 : Poly) : blockFold len m0 w0 0 = ⟨m0, 0, w0⟩ := rfl

theorem blockFold_fst (len m0 : Nat) (w0 : Poly) (i : Nat) : (blockFold len m0 w0 i).fst = m0 + i := by
  induction i with
  | zero => rfl
  | succ i ih => rw [blockFold_succ]; simp [blockF, ih]; omega

theorem blockFold_start (len m0 : Nat) (w0 : Poly) (i : Nat) :
    (blockFold len m0 w0 i).snd.fst = 2 * len * i := by
  induction i with
  | zero => rfl
  | succ i ih => rw [blockFold_succ]; simp [blockF, ih]; ring

theorem outer_loop (LEN ITER : Usize) (hLEN : 0 < LEN.val) (hprod : LEN.val * ITER.val = 128)
    (w0 : Array U32 256#usize) (hw0 : Canonical w0) (m0 : Usize) (hm : m0.val + ITER.val < 256) :
    ntt.ntt_layer_loop0 LEN ITER w0 m0 0#usize ⦃ r =>
      Canonical r.1 ∧ r.2.val = m0.val + ITER.val ∧
      toZq r.1 = (blockFold LEN.val m0.val (toZq w0) ITER.val).snd.snd ⦄ := by
  unfold ntt.ntt_layer_loop0
  apply loop.spec_decr_nat
    (fun (p : Array U32 256#usize × Usize × Usize) => ITER.val - p.2.2.val)
    (fun p => Canonical p.1 ∧ p.2.2.val ≤ ITER.val ∧ p.2.1.val = m0.val + p.2.2.val ∧
       toZq p.1 = (blockFold LEN.val m0.val (toZq w0) p.2.2.val).snd.snd)
  · rintro ⟨w, m, i⟩ ⟨hc, h1, h2, h3⟩
    dsimp only at hc h1 h2 h3
    simp only [ntt.ntt_layer_loop0.body]
    split
    · rename_i hi
      have hi' : i.val < ITER.val := hi
      have hbound : 2 * LEN.val * (i.val + 1) ≤ 256 := by
        have := Nat.mul_le_mul_left LEN.val (show i.val + 1 ≤ ITER.val by omega)
        nlinarith
      have hbound2 : (i.val * 2) * LEN.val ≤ 256 := by nlinarith
      step*
      · rw [i1_post]; scalar_tac
      · exact zetas_shoup_get m1 (by omega) ‹_› ‹_› _ _ ‹_› ‹_›
      · have e : (i.val * 2 * LEN.val) + 2 * LEN.val = 2 * LEN.val * (i.val + 1) := by ring
        rw [start_post, i1_post]; omega
      · obtain ⟨_, hzeta⟩ := zetas_get m1 (by omega) ‹_› _ ‹_›
        have e1 : m1.val = m0.val + i.val + 1 := by omega
        have e2 : start.val = 2 * LEN.val * i.val := by rw [start_post, i1_post]; ring
        refine ⟨w1_post1, by omega, by omega, ?_, by omega⟩
        rw [w1_post2, hzeta, i2_post, blockFold_succ, e1, e2, h3]
        simp [blockF, blockFold_fst, blockFold_start]
    · rename_i hi
      have hi' : i.val = ITER.val := by scalar_tac
      simp only [WP.spec_ok]
      exact ⟨hc, by omega, by rw [h3, hi']⟩
  · refine ⟨hw0, by simp, by simp, ?_⟩
    simp [blockFold_zero]

theorem layer_spec (LEN ITER : Usize) (hLEN : 0 < LEN.val) (hprod : LEN.val * ITER.val = 128)
    (w : Array U32 256#usize) (hw : Canonical w) (m : Usize) (hm : m.val + ITER.val < 256) :
    ntt.ntt_layer LEN ITER w m ⦃ r => Canonical r.1 ∧ r.2.val = m.val + ITER.val ∧
      (toZq r.1, r.2.val) = nttLayer LEN.val (toZq w) m.val ⦄ := by
  unfold ntt.ntt_layer
  apply WP.spec_mono (outer_loop LEN ITER hLEN hprod w hw m hm)
  rintro ⟨w', m'⟩ ⟨h1, h2, h3⟩
  refine ⟨h1, h2, ?_⟩
  have hdiv : 256 / (2 * LEN.val) = ITER.val := by
    apply Nat.div_eq_of_eq_mul_right (by omega)
    nlinarith
  rw [nttLayer_eq, hdiv]
  simp only at h2 h3 ⊢
  rw [h3, h2, blockFold_fst]

/-- Algorithm 41 is the composition of its eight layers. -/
theorem NTT_eq_layers (w : Poly) :
    NTT w = (let p := nttLayer 128 w 0
             let p := nttLayer 64 p.1 p.2
             let p := nttLayer 32 p.1 p.2
             let p := nttLayer 16 p.1 p.2
             let p := nttLayer 8 p.1 p.2
             let p := nttLayer 4 p.1 p.2
             let p := nttLayer 2 p.1 p.2
             (nttLayer 1 p.1 p.2).1) := by
  simp [NTT, Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size, List.range'_succ]

attribute [step] layer_spec

/-- The shared in-place body (`ntt_body_mut`, extracted as a function of the array it transforms). -/
theorem ntt_body_mut_spec (w : Array U32 256#usize) (hw : Canonical w) :
    ntt.ntt_body_mut w ⦃ r => Canonical r ∧ toZq r = Spec.NTT (toZq w) ⦄ := by
  unfold ntt.ntt_body_mut
  step*
  refine ⟨w8_post1, ?_⟩
  simp only [NTT_eq_layers, ← w1_post3, ← w2_post3, ← w3_post3, ← w4_post3, ← w5_post3,
    ← w6_post3, ← w7_post3, ← w8_post3]

theorem ntt_spec (w : Array U32 256#usize) (hw : Canonical w) :
    ntt.ntt w ⦃ r => Canonical r ∧ toZq r = Spec.NTT (toZq w) ⦄ := by
  unfold ntt.ntt ntt.dispatch.ntt ntt.ntt_body
  exact ntt_body_mut_spec w hw

/-- The in-place entry point `ntt_in_place` (the Rust takes `&mut [u32; 256]`; the extraction passes the array in and
returns the updated one) satisfies the same spec as `ntt`. -/
theorem ntt_in_place_spec (w : Array U32 256#usize) (hw : Canonical w) :
    ntt.ntt_in_place w ⦃ r => Canonical r ∧ toZq r = Spec.NTT (toZq w) ⦄ := by
  unfold ntt.ntt_in_place ntt.dispatch.ntt_in_place
  exact ntt_body_mut_spec w hw

/-- **Headline theorem.** On canonical input the extracted `ntt` returns, without failing or diverging,
a canonical array whose coefficients are those of FIPS 204 Algorithm 41 applied to the input. -/
theorem ntt_correct (w : Array U32 256#usize) (hw : Canonical w) :
    ∃ r, ntt.ntt w = ok r ∧ Canonical r ∧ toZq r = Spec.NTT (toZq w) := by
  obtain ⟨r, hr, h⟩ := WP.spec_imp_exists (ntt_spec w hw)
  exact ⟨r, hr, h⟩

end Proofs
