import Proofs.TopWitnessFast
import Proofs.NTT
import Proofs.NTTInverse
import Proofs.KeccakBytes

/-!
# Splitting the heavy kernel stage lemmas of the witnesses into pieces

The memory of one kernel check grows with the work it does (the kernel caches every intermediate term), so the heavy
stage lemmas of `TopWitness*` (`NTT`, `NTTInv`, `SHAKE256` on a long message, a matrix-vector product) are each checked
piece by piece: this module proves, for all inputs, that they equal a composition of pieces, and the stage modules
(generated by `scripts/gen-witness-stages.py`) check one piece per declaration against the literal values printed by
`SpecTests/WitnessMidGen.lean` (`Proofs/TopWitnessMid.lean`). The statements of the stage lemmas are unchanged; only
their proofs go through the pieces. This module is not imported by the default build roots.
-/

open Spec
set_option maxRecDepth 8192

namespace Proofs
namespace TopWitness

/-! ## `NTT`: layers `a, ..., b - 1` -/

/-- The layers `a ≤ t < b` of the forward NTT (`len = 128 >>> t`), on the pair `(ŵ, m)` of `Spec.nttLayer`. -/
def fwdLayers (a b : Nat) (p : Poly × Nat) : Poly × Nat :=
  (List.range' a (b - a)).foldl (fun p t => nttLayer (128 >>> t) p.1 p.2) p

theorem fwdLayers_split (a b c : Nat) (hab : a ≤ b) (hbc : b ≤ c) (p : Poly × Nat) :
    fwdLayers a c p = fwdLayers b c (fwdLayers a b p) := by
  unfold fwdLayers
  have h1 : c - a = (b - a) + (c - b) := by omega
  have h2 : a + 1 * (b - a) = b := by omega
  rw [h1, ← List.range'_append, List.foldl_append, h2]

/-- The forward NTT is its eight layers. -/
theorem NTT_eq_fwdLayers (w : Poly) : NTT w = (fwdLayers 0 8 (w, 0)).1 := by
  rw [NTT_eq_layers]
  rfl

/-! ## `NTTInv`: layers `a, ..., b - 1`, then the scaling -/

/-- The layers `a ≤ t < b` of the inverse NTT (`len = 1 <<< t`), on the pair `(w, m)` of `Spec.nttInvLayer`. -/
def invLayers (a b : Nat) (p : Poly × Nat) : Poly × Nat :=
  (List.range' a (b - a)).foldl (fun p t => nttInvLayer (1 <<< t) p.1 p.2) p

theorem invLayers_split (a b c : Nat) (hab : a ≤ b) (hbc : b ≤ c) (p : Poly × Nat) :
    invLayers a c p = invLayers b c (invLayers a b p) := by
  unfold invLayers
  have h1 : c - a = (b - a) + (c - b) := by omega
  have h2 : a + 1 * (b - a) = b := by omega
  rw [h1, ← List.range'_append, List.foldl_append, h2]

/-- The multiplication by `256⁻¹` at the end of `NTTInv` (Algorithm 42, steps 16-18). -/
def invScale (w : Poly) : Poly := (List.range' 0 256).foldl scaleF w

/-- The inverse NTT is its eight layers followed by the scaling. -/
theorem NTTInv_eq_invLayers (w : Poly) : NTTInv w = invScale (invLayers 0 8 (w, 256)).1 := by
  rw [NTTInv_eq_layers]
  rfl

/-! ## SHAKE256 on a long message: the absorbed blocks `i, ..., i + n - 1` -/

/-- The state after absorbing the blocks `i, ..., i + n - 1` of `P` (rate `r`, block `t` is bytes `r t, ..., r t + r - 1`),
starting from the state `S`. `Spec.Keccak.absorb` is this for all the blocks of `P`. -/
def absorbFrom (r : Nat) (P : List UInt8) : Nat → Nat → Keccak.State → Keccak.State
  | _, 0, S => S
  | i, n + 1, S => absorbFrom r P (i + 1) n (KeccakF1600 (Keccak.xorBlock S ((P.drop (r * i)).take r)))

theorem absorbFrom_add (r : Nat) (P : List UInt8) :
    ∀ (m n i : Nat) (S : Keccak.State), absorbFrom r P i (m + n) S = absorbFrom r P (i + m) n (absorbFrom r P i m S) := by
  intro m
  induction m with
  | zero => intro n i S; simp [absorbFrom]
  | succ m ih =>
    intro n i S
    rw [show m + 1 + n = (m + n) + 1 by omega]
    simp only [absorbFrom]
    rw [ih, show i + 1 + m = i + (m + 1) by omega]

/-- Cut the `k = m + n` blocks from block `i` into the first `m` blocks and the other `n` (which start at block `i' = i + m`). -/
theorem absorbFrom_cut (r : Nat) (P : List UInt8) (S : Keccak.State) (i m n k i' : Nat) (hk : m + n = k) (hi : i + m = i') :
    absorbFrom r P i k S = absorbFrom r P i' n (absorbFrom r P i m S) := by
  subst hk hi
  exact absorbFrom_add r P m n i S

theorem absorb_eq_absorbFrom (r : Nat) (hr : 0 < r) (P : List UInt8) :
    ∀ (n i : Nat) (S : Keccak.State), P.length = r * (i + n) →
      Keccak.absorb r S (P.drop (r * i)) = absorbFrom r P i n S := by
  intro n
  induction n with
  | zero =>
    intro i S h
    have : P.drop (r * i) = [] := List.drop_eq_nil_of_le (by rw [h, Nat.add_zero])
    rw [this, KM.absorb_nil]
    rfl
  | succ n ih =>
    intro i S h
    have hl : 0 < r ∧ r ≤ (P.drop (r * i)).length := by
      refine ⟨hr, ?_⟩
      rw [List.length_drop, h]
      have : r * (i + (n + 1)) = r * i + r * (n + 1) := by ring
      have : r ≤ r * (n + 1) := Nat.le_mul_of_pos_right r (Nat.succ_pos n)
      omega
    rw [KM.absorb_step r S _ hl, List.drop_drop, absorbFrom]
    rw [show r * i + r = r * (i + 1) by ring]
    exact ih (i + 1) _ (by rw [h]; congr 1; omega)

/-- `Spec.H` on `M` is the squeeze of the state after absorbing the `n` blocks of `pad101 136 M`. -/
theorem H_eq_absorbFrom (M : List UInt8) (d n : Nat) (hn : (Keccak.pad101 136 M).length = 136 * n) :
    Spec.H M d = Keccak.squeeze 136 d (absorbFrom 136 (Keccak.pad101 136 M) 0 n Keccak.zeroState) := by
  unfold Spec.H Spec.SHAKE256 Keccak.sponge
  have h := absorb_eq_absorbFrom 136 (by norm_num) (Keccak.pad101 136 M) n 0 Keccak.zeroState (by simpa using hn)
  simp only [Nat.mul_zero, List.drop_zero] at h
  rw [← h]

/-- A Keccak state from its 25 lanes, as printed by `SpecTests/WitnessMidGen.lean`. -/
def stOf (l : List Nat) : Keccak.State := Vector.ofFn (n := 25) fun i => (l.getD i.val 0).toUInt64

/-! ## Polynomial arithmetic on literals as arithmetic on natural-number lists

`Zq` arithmetic is the expensive part of a kernel evaluation (every `Nat.cast` and every `*` goes through the `ZMod`
instances and is cached), natural-number arithmetic is not (GMP). The coefficient lists of the literals `Pl l` are
combined as lists of naturals, and `Pl_add` / `Pl_mul` show that this is the same as the pointwise sum / product of the
polynomials. -/

/-- The pointwise sum of two coefficient lists, reduced mod `q`. -/
def addL (a b : List Nat) : List Nat := List.zipWith (fun x y => (x + y) % Spec.q) a b

/-- The pointwise product of two coefficient lists, reduced mod `q`. -/
def mulL (a b : List Nat) : List Nat := List.zipWith (fun x y => (x * y) % Spec.q) a b

theorem Pl_getElem (l : List Nat) (h : l.length = 256) (i : Nat) (hi : i < 256) :
    (Pl l)[i] = ((l[i]'(by omega) : Nat) : Zq) := by
  unfold Pl
  rw [dif_pos h]
  simp

theorem Pl_add (a b : List Nat) (ha : a.length = 256) (hb : b.length = 256) : Pl a + Pl b = Pl (addL a b) := by
  have hl : (addL a b).length = 256 := by simp [addL, ha, hb]
  apply Vector.ext
  intro i hi
  show (Vector.zipWith (· + ·) (Pl a) (Pl b))[i] = _
  rw [Vector.getElem_zipWith, Pl_getElem a ha i hi, Pl_getElem b hb i hi, Pl_getElem _ hl i hi]
  simp [addL, ZMod.natCast_mod, Nat.cast_add]

theorem Pl_mul (a b : List Nat) (ha : a.length = 256) (hb : b.length = 256) :
    Vector.zipWith (· * ·) (Pl a) (Pl b) = Pl (mulL a b) := by
  have hl : (mulL a b).length = 256 := by simp [mulL, ha, hb]
  apply Vector.ext
  intro i hi
  rw [Vector.getElem_zipWith, Pl_getElem a ha i hi, Pl_getElem b hb i hi, Pl_getElem _ hl i hi]
  simp [mulL, ZMod.natCast_mod, Nat.cast_mul]

theorem Pl_zero : Poly.zero = Pl (List.replicate 256 0) := by
  apply Vector.ext
  intro i hi
  rw [Pl_getElem _ (by simp) i hi]
  simp only [Poly.zero, List.getElem_replicate, Vector.getElem_replicate, Nat.cast_zero]

/-! ## Comparing a sampled polynomial with a literal as natural numbers -/

/-- The coefficients of `p` as natural numbers. -/
def polyVals (p : Poly) : List Nat := p.toList.map ZMod.val

theorem eq_Pl_of_vals (p : Poly) (l : List Nat) (hl : l.length = 256) (h : polyVals p = l) : p = Pl l := by
  subst h
  apply Vector.ext
  intro i hi
  rw [Pl_getElem _ hl i hi]
  simp [polyVals]

/-- `o = some (Pl l)` if the coefficients of the polynomial in `o` are `l`: the kernel then compares two lists of natural
numbers instead of two vectors of `ZMod` elements. -/
theorem opt_eq_Pl_of_vals (o : Option Poly) (l : List Nat) (h : o.map polyVals = some l) (hl : l.length = 256) :
    o = some (Pl l) := by
  cases o with
  | none => simp at h
  | some p =>
    simp only [Option.map_some, Option.some.injEq] at h
    rw [eq_Pl_of_vals p l hl h]

/-! ## `MatrixVectorNTT` -/

/-- The inner step of `MatrixVectorNTTF`. -/
def mvInnerF {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) (i : Nat) (w : Vector Poly k) (j : Nat) :
    Vector Poly k :=
  w.set! i (w[i]! + Vector.zipWith (· * ·) (M[i]!)[j]! V[j]!)

/-- The outer step of `MatrixVectorNTTF`. -/
def mvOuterF {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) (w : Vector Poly k) (i : Nat) :
    Vector Poly k :=
  (List.range' 0 ℓ).foldl (mvInnerF M V i) w

theorem MatrixVectorNTTF_eq {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) :
    MatrixVectorNTTF M V = (List.range' 0 k).foldl (mvOuterF M V) (Vector.replicate k Poly.zero) := by
  simp [MatrixVectorNTTF, Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size]
  rfl

/-- Row `i` of the product: the sum of the `ℓ` pointwise products. -/
def mvRow {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) (i : Nat) : Poly :=
  (List.range' 0 ℓ).foldl (fun a j => a + Vector.zipWith (· * ·) (M[i]!)[j]! V[j]!) Poly.zero

theorem vset_self {n : Nat} (w : Vector Poly n) (i : Nat) (hi : i < n) : w.set! i w[i]! = w := by
  apply Vector.ext
  intro k hk
  rw [set!_eq', Vector.getElem_setIfInBounds hk]
  by_cases e : i = k
  · subst e
    rw [if_pos rfl]
    exact getElem!_pos w i hi
  · simp [e]

theorem vset_get {n : Nat} (w : Vector Poly n) (i : Nat) (x : Poly) (hi : i < n) : (w.set! i x)[i]! = x := by
  rw [getElem!_pos (w.set! i x) i hi, set!_eq', Vector.getElem_setIfInBounds hi]
  simp

theorem vset_set {n : Nat} (w : Vector Poly n) (i : Nat) (x y : Poly) : (w.set! i x).set! i y = w.set! i y := by
  apply Vector.ext
  intro k hk
  by_cases e : i = k <;> simp [set!_eq', e]

theorem mvInner_fold {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) (i : Nat) (hi : i < k) (n : Nat)
    (w : Vector Poly k) :
    (List.range' 0 n).foldl (mvInnerF M V i) w =
      w.set! i ((List.range' 0 n).foldl (fun a j => a + Vector.zipWith (· * ·) (M[i]!)[j]! V[j]!) w[i]!) := by
  induction n with
  | zero => simp [vset_self w i hi]
  | succ n ih =>
    rw [List.range'_concat, List.foldl_append, List.foldl_append, ih]
    simp only [List.foldl_cons, List.foldl_nil, mvInnerF, Nat.zero_add, Nat.one_mul]
    rw [vset_get _ _ _ hi, vset_set]

theorem mvOuter_fold {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) (n : Nat) (hn : n ≤ k) :
    (List.range' 0 n).foldl (mvOuterF M V) (Vector.replicate k Poly.zero) =
      Vector.ofFn (fun idx : Fin k => if idx.val < n then mvRow M V idx.val else Poly.zero) := by
  induction n with
  | zero =>
    apply Vector.ext
    intro idx hidx
    simp
  | succ n ih =>
    rw [List.range'_concat, List.foldl_append, ih (by omega)]
    simp only [List.foldl_cons, List.foldl_nil, mvOuterF, Nat.zero_add, Nat.one_mul]
    rw [mvInner_fold M V n (by omega)]
    apply Vector.ext
    intro idx hidx
    rw [set!_eq', Vector.getElem_setIfInBounds hidx]
    by_cases e : n = idx
    · subst e
      have : (Vector.ofFn (fun idx' : Fin k => if idx'.val < n then mvRow M V idx'.val else Poly.zero))[n]! = Poly.zero := by
        rw [getElem!_pos _ _ (by omega)]
        simp
      have hM : M[n]! = M[n] := getElem!_pos M n hidx
      rw [this]
      simp [mvRow, hM]
    · have hh : (idx < n + 1 ↔ idx < n) := by omega
      have hh' : (idx ≤ n ↔ idx < n) := by omega
      simp [e, hh']

theorem MatrixVectorNTTF_rows {k ℓ : Nat} (M : Vector (Vector Poly ℓ) k) (V : Vector Poly ℓ) :
    MatrixVectorNTTF M V = Vector.ofFn (fun i : Fin k => mvRow M V i.val) := by
  rw [MatrixVectorNTTF_eq, mvOuter_fold M V k (Nat.le_refl k)]
  congr 1
  funext idx
  simp [idx.isLt]

/-- Row of a product with four entries. -/
def row4 (a0 a1 a2 a3 x0 x1 x2 x3 : Poly) : Poly :=
  (((Poly.zero + Vector.zipWith (· * ·) a0 x0) + Vector.zipWith (· * ·) a1 x1) + Vector.zipWith (· * ·) a2 x2) +
    Vector.zipWith (· * ·) a3 x3

/-- The same row as natural-number lists. -/
def row4L (a0 a1 a2 a3 x0 x1 x2 x3 : List Nat) : List Nat :=
  addL (addL (addL (addL (List.replicate 256 0) (mulL a0 x0)) (mulL a1 x1)) (mulL a2 x2)) (mulL a3 x3)

theorem row4_Pl (a0 a1 a2 a3 x0 x1 x2 x3 : List Nat)
    (h : [a0, a1, a2, a3, x0, x1, x2, x3].all (fun l => l.length == 256) = true) :
    row4 (Pl a0) (Pl a1) (Pl a2) (Pl a3) (Pl x0) (Pl x1) (Pl x2) (Pl x3) = Pl (row4L a0 a1 a2 a3 x0 x1 x2 x3) := by
  simp only [List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨h0, h1, h2, h3, g0, g1, g2, g3⟩ := h
  have len : ∀ a b : List Nat, a.length = 256 → b.length = 256 → (mulL a b).length = 256 := by
    intro a b ha hb; simp [mulL, ha, hb]
  have lena : ∀ a b : List Nat, a.length = 256 → b.length = 256 → (addL a b).length = 256 := by
    intro a b ha hb; simp [addL, ha, hb]
  have lz : (List.replicate 256 0).length = 256 := by simp
  unfold row4 row4L
  rw [Pl_zero, Pl_mul a0 x0 h0 g0, Pl_mul a1 x1 h1 g1, Pl_mul a2 x2 h2 g2, Pl_mul a3 x3 h3 g3,
    Pl_add _ _ lz (len _ _ h0 g0), Pl_add _ _ (lena _ _ lz (len _ _ h0 g0)) (len _ _ h1 g1),
    Pl_add _ _ (lena _ _ (lena _ _ lz (len _ _ h0 g0)) (len _ _ h1 g1)) (len _ _ h2 g2),
    Pl_add _ _ (lena _ _ (lena _ _ (lena _ _ lz (len _ _ h0 g0)) (len _ _ h1 g1)) (len _ _ h2 g2)) (len _ _ h3 g3)]

/-- `MatrixVectorNTT` of a `4 × 4` matrix and a vector of length 4, row by row. -/
theorem MatrixVectorNTTF_v4 (a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33 x0 x1 x2 x3 : Poly) :
    MatrixVectorNTTF (v4 (v4 a00 a01 a02 a03) (v4 a10 a11 a12 a13) (v4 a20 a21 a22 a23) (v4 a30 a31 a32 a33))
        (v4 x0 x1 x2 x3) =
      v4 (row4 a00 a01 a02 a03 x0 x1 x2 x3) (row4 a10 a11 a12 a13 x0 x1 x2 x3) (row4 a20 a21 a22 a23 x0 x1 x2 x3)
        (row4 a30 a31 a32 a33 x0 x1 x2 x3) := by
  rw [MatrixVectorNTTF_rows]
  apply Vector.ext
  intro i hi
  have h4 : i < 4 := hi
  interval_cases i <;> rfl

/-! ## Rounding, norms and hints of a vector of four polynomials, one polynomial at a time -/

/-- `Power2RoundVec` of four polynomials is checked one polynomial at a time. -/
theorem Power2RoundVec_v4 (p : Spec.Params) (a b c d : Poly) (a1 b1 c1 d1 a0 b0 c0 d0 : RPoly)
    (ha : (a.map (fun x => (Power2Round p x).1), a.map (fun x => (Power2Round p x).2)) = (a1, a0))
    (hb : (b.map (fun x => (Power2Round p x).1), b.map (fun x => (Power2Round p x).2)) = (b1, b0))
    (hc : (c.map (fun x => (Power2Round p x).1), c.map (fun x => (Power2Round p x).2)) = (c1, c0))
    (hd : (d.map (fun x => (Power2Round p x).1), d.map (fun x => (Power2Round p x).2)) = (d1, d0)) :
    Spec.Power2RoundVec p (v4 a b c d) = (v4 a1 b1 c1 d1, v4 a0 b0 c0 d0) := by
  simp only [Prod.mk.injEq] at ha hb hc hd
  obtain ⟨ha1, ha0⟩ := ha
  obtain ⟨hb1, hb0⟩ := hb
  obtain ⟨hc1, hc0⟩ := hc
  obtain ⟨hd1, hd0⟩ := hd
  unfold Spec.Power2RoundVec
  rw [v4_map, v4_map]
  simp only [ha1, ha0, hb1, hb0, hc1, hc0, hd1, hd0]

/-- `HighBitsVec` of four polynomials is checked one polynomial at a time. -/
theorem HighBitsVec_v4 (p : Spec.Params) (a b c d : Poly) (a1 b1 c1 d1 : RPoly)
    (ha : a.map (HighBits p) = a1) (hb : b.map (HighBits p) = b1) (hc : c.map (HighBits p) = c1)
    (hd : d.map (HighBits p) = d1) :
    Spec.HighBitsVec p (v4 a b c d) = v4 a1 b1 c1 d1 := by
  unfold Spec.HighBitsVec
  rw [v4_map]
  simp only [ha, hb, hc, hd]

theorem LowBitsVec_v4 (p : Spec.Params) (a b c d : Poly) :
    Spec.LowBitsVec p (v4 a b c d) = v4 (a.map (LowBits p)) (b.map (LowBits p)) (c.map (LowBits p)) (d.map (LowBits p)) := by
  unfold Spec.LowBitsVec
  rw [v4_map]

/-- The norm of a vector of four elements is below `B` if the norm of each is. -/
theorem not_le_norm_v4 {α : Type} [InfNorm α] (B : Nat) (a b c d : α) (ha : ‖a‖∞ < B) (hb : ‖b‖∞ < B)
    (hc : ‖c‖∞ < B) (hd : ‖d‖∞ < B) : ¬ (B ≤ ‖v4 a b c d‖∞) := by
  show ¬ (B ≤ max (max (max (max 0 ‖a‖∞) ‖b‖∞) ‖c‖∞) ‖d‖∞)
  omega

theorem MakeHintVec_v4 (p : Spec.Params) (z0 z1 z2 z3 r0 r1 r2 r3 : Poly) :
    Spec.MakeHintVec p (v4 z0 z1 z2 z3) (v4 r0 r1 r2 r3) =
      v4 (Vector.zipWith (MakeHint p) z0 r0) (Vector.zipWith (MakeHint p) z1 r1) (Vector.zipWith (MakeHint p) z2 r2)
        (Vector.zipWith (MakeHint p) z3 r3) := by
  unfold Spec.MakeHintVec
  rw [v4_zipWith]

/-- The hint weight is at most `ω` if the weights of the four polynomials are `n₀, ..., n₃` with `n₀ + ... + n₃ ≤ ω`. -/
theorem HintWeight_v4_le (a b c d : HintPoly) (n0 n1 n2 n3 ω : Nat) (h0 : a.countP (fun x => x) = n0)
    (h1 : b.countP (fun x => x) = n1) (h2 : c.countP (fun x => x) = n2) (h3 : d.countP (fun x => x) = n3)
    (hs : n0 + n1 + n2 + n3 ≤ ω) : HintWeight (v4 a b c d) ≤ ω := by
  show 0 + a.countP (fun x => x) + b.countP (fun x => x) + c.countP (fun x => x) + d.countP (fun x => x) ≤ ω
  omega

