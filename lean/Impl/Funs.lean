            p.beta p.gamma1 p.gamma1_bits p.gamma2 p.w1_bits p.omega
            p.c_tilde_len p.two_gamma2_shift p.two_gamma2_mult
            p.two_gamma2_div_mult h az_hat c_hat t1_2d_hat w_approx w1 0#usize
