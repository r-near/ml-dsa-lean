// ML-DSA-44: the readable transcription of FIPS 204 in cryptol-specs (Specification.cry), instantiated with the
// parameters of FIPS 204 Table 1 (the same values as Instantiations/ML_DSA_44.cry).
module Spec44 = Primitive::Asymmetric::Signature::ML_DSA::Specification where

        type q = 8380417
        type τ = 39
        type λ = 128
        type γ1 = 2 ^^ 17
        type γ2 = (q - 1) / 88
        type k = 4
        type ell = 4
        type η = 2
        type ω = 80
