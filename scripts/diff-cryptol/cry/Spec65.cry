// ML-DSA-65: the readable transcription of FIPS 204 in cryptol-specs (Specification.cry), instantiated with the
// parameters of FIPS 204 Table 1 (the same values as Instantiations/ML_DSA_65.cry).
module Spec65 = Primitive::Asymmetric::Signature::ML_DSA::Specification where

        type q = 8380417
        type τ = 49
        type λ = 192
        type γ1 = 2 ^^ 19
        type γ2 = (q - 1) / 32
        type k = 6
        type ell = 5
        type η = 4
        type ω = 55
